<% content_for :title, "Dasbor Mahasiswa — #{@student.full_name}" %>
<div class="space-y-6">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 flex items-start gap-4 flex-wrap">
    <span class="h-14 w-14 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl font-bold shrink-0"><%= @student.full_name.first.upcase %></span>
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Dasbor Mahasiswa</p>
      <h1 class="text-xl font-bold text-gray-900"><%= @student.full_name %></h1>
      <p class="text-sm text-gray-500"><%= @student.email %>
        <% if @student.identifier_number.present? %> · <%= @student.identifier_label %> <%= @student.identifier_number %><% end %>
        <% if @student.study_program %> · <%= @student.study_program.name %><% end %>
        <% if @student.cohort_year %> · angkatan <%= @student.cohort_year %><% end %></p>
      <% if @ongoing_rotation %>
        <p class="text-xs text-emerald-700 mt-1">Rotasi berjalan: <strong><%= @ongoing_rotation.station_name %></strong> s.d. <%= l(@ongoing_rotation.end_date, format: :long) %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if @can_edit %>
        <%= link_to "Sunting akun", edit_admin_user_path(@student), class: "text-xs font-semibold rounded-xl ring-1 ring-gray-300 px-3 py-2 hover:bg-gray-50" %>
      <% end %>
      <% if @epa_available %><%= link_to "Peta EPA", entrustment_decisions_path(student_id: @student.id), class: "text-xs font-semibold rounded-xl bg-indigo-600 text-white px-3 py-2 hover:bg-indigo-700" %><% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" data-testid="student-stats">
    <% [ [ @scored_count, "Nilai tercatat" ], [ @pending_count, "Asesmen menunggu" ], [ @activity_count, "Kegiatan logbook" ], [ @verified_case_count, "Kasus terverifikasi" ] ].each do |val, label| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
        <p class="text-2xl font-bold text-gray-900"><%= val %></p>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400"><%= label %></p>
      </div>
    <% end %>
  </div>

  <%= render "dashboard/assessment_hub", student: @student, pending_count: @pending_count %>

  <% cycles_with_requirements = @evidence_cycle_summaries.select { |cycle| cycle.requirement_count.positive? } %>
  <% if cycles_with_requirements.any? %>
    <section class="rounded-2xl bg-white p-5 ring-1 ring-gray-200" data-testid="evidence-cycle-summary">
      <h2 class="text-sm font-semibold text-gray-800">Kecukupan bukti per siklus akademik</h2>
      <p class="mt-1 text-xs text-gray-500">Bukti dikelompokkan menurut tanggal bukti pada periode akademik. Ringkasan ini menunjukkan kecukupan, bukan keputusan capaian kompetensi.</p>
      <div class="mt-3 divide-y divide-gray-100">
        <% cycles_with_requirements.each do |cycle| %>
          <details class="py-3">
            <summary class="cursor-pointer list-none">
              <div class="grid gap-2 text-xs sm:grid-cols-6 sm:items-center">
                <span class="font-semibold text-gray-800 sm:col-span-2"><%= cycle.academic_period.name %></span>
                <span><strong><%= cycle.fulfilled_count %>/<%= cycle.requirement_count %></strong> terpenuhi</span>
                <span><%= cycle.in_progress_count %> berjalan</span>
                <span><%= cycle.not_started_count %> belum mulai</span>
                <span class="<%= cycle.critical_gap_count.positive? ? 'font-semibold text-rose-700' : 'text-gray-600' %>"><%= cycle.critical_gap_count %> wajib/kritis tersisa</span>
              </div>
            </summary>
            <ul class="mt-2 space-y-1 pl-2 text-xs text-gray-600">
              <% cycle.requirements.each do |entry| %>
                <li><%= entry[:requirement].epa&.code || entry[:requirement].competency_indicator&.code || entry[:requirement].competency_item&.code || "Bukti yang Diharapkan" %> · <%= entry[:progress].record_count %>/<%= entry[:progress].required_count %> bukti valid · <%= entry[:progress].status.to_s.humanize %><%= " · Wajib/kritis" if entry[:critical] %></li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @framework %>
    <section class="rounded-2xl bg-white p-5 ring-1 ring-gray-200">
      <h2 class="text-sm font-semibold text-gray-800">Pencapaian kompetensi · framework versi <%= @framework.version %></h2>
      <div class="mt-3 divide-y divide-gray-100">
        <% @framework.competency_items.includes(:parent).order(:position).each do |item| %>
          <% attainment = @competency_attainments[item.id] %>
          <div class="py-3">
            <div class="flex items-start justify-between gap-3">
              <div><p class="text-sm font-medium text-gray-800"><%= "— " if item.parent_id.present? %><%= item.title %></p>
                <% if attainment %><p class="mt-1 text-xs text-gray-500">Level <%= attainment.attainment_level || "—" %> · <%= attainment.status.humanize %> · diusulkan <%= attainment.decision_by&.full_name %> · <%= l(attainment.decision_date, format: :short) %><%= " · framework v#{attainment.framework_version}" if attainment.framework_version.present? %></p><p class="text-xs text-gray-500"><%= attainment.rationale %></p>
                  <% if attainment.status == "proposed" && @can_review_attainment %>
                    <%= form_with url: review_student_competency_attainment_path(@student, attainment), method: :patch,
                      class: "mt-2 grid gap-2 sm:grid-cols-[10rem_1fr_auto]" do |f| %>
                      <%= f.select :decision, [["Setujui", "approved"], ["Tolak", "rejected"]], {}, class: "rounded-lg border-gray-300 text-xs" %>
                      <%= f.text_field :review_notes, required: true, minlength: 10, placeholder: "Catatan keputusan Otoritas Akademik", class: "rounded-lg border-gray-300 text-xs" %>
                      <%= f.submit "Tinjau usulan", class: "rounded-lg bg-emerald-700 px-3 py-2 text-xs font-semibold text-white" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
            <% if @can_propose_attainment %>
              <%= form_with url: student_competency_attainments_path(@student), class: "mt-2 grid grid-cols-1 sm:grid-cols-[10rem_1fr_auto] gap-2" do |f| %>
                <%= hidden_field_tag :competency_item_id, item.id %>
                <%= select_tag :attainment_level, options_for_select((1..5).map { |level| ["Level #{level}", level] }), class: "rounded-lg border-gray-300 text-xs" %>
                <%= text_field_tag :rationale, nil, required: true, minlength: 10, placeholder: "Alasan keputusan berdasarkan bukti…", class: "rounded-lg border-gray-300 text-xs" %>
                <%= submit_tag "Ajukan capaian", class: "rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white cursor-pointer" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
