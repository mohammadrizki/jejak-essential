<div class="max-w-6xl mx-auto px-4 py-6 space-y-5">
  <div><h1 class="text-2xl font-bold">Promosi EPA ke Otoritas Akademik</h1><p class="text-sm text-gray-600">Penanda kesiapan menunjukkan kecukupan bukti; panel tetap mengambil keputusan entrustment secara terpisah.</p></div>
  <% @promotions.each do |promotion| %>
    <% readiness = @readiness[promotion] %>
    <article class="rounded-2xl border border-gray-200 bg-white p-5 space-y-3">
      <div class="flex flex-wrap justify-between gap-2"><div><h2 class="font-semibold"><%= promotion.student.full_name %> · <%= promotion.epa.code %></h2><p class="text-sm text-gray-600"><%= promotion.epa.title %></p></div><span class="rounded-full bg-indigo-50 px-3 py-1 text-sm text-indigo-800"><%= promotion.status.humanize %></span></div>
      <% if readiness.eligible %><p class="text-sm text-emerald-800">Siap dipromosikan: semua Syarat Bukti aktif terpenuhi dan tidak ada flag keselamatan terbuka.</p><% else %><ul class="list-disc pl-5 text-sm text-amber-800"><% readiness.reasons.each do |reason| %><li><%= reason %></li><% end %></ul><% end %>
      <% if promotion.epa_promotion_reviews.any? %>
        <div class="rounded-lg bg-slate-50 p-3 text-xs text-slate-700">
          <p class="font-semibold">Tinjauan panel</p>
          <% promotion.epa_promotion_reviews.includes(:reviewer, :supervision_level).order(:created_at).each do |review| %>
            <p class="mt-1"><%= review.reviewer.full_name %> · <%= review.recommendation.humanize %><%= " · #{review.supervision_level.label}" if review.supervision_level %> — <%= review.notes %></p>
          <% end %>
        </div>
      <% end %>
      <% if promotion.status == "ready" && (current_user.has_role?("preseptor") || current_user.has_role?("admin")) && readiness.eligible %>
        <%= button_to "Ajukan ke Otoritas Akademik", promote_epa_promotion_path(promotion), method: :patch, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
      <% elsif promotion.status.in?(%w[promoted under_review]) && (current_user.has_role?("kaprodi") || current_user.has_role?("admin")) %>
        <%= form_with url: review_epa_promotion_path(promotion), method: :patch, class: "grid gap-3 sm:grid-cols-2" do |f| %>
          <%= f.select :recommendation, [["Setuju level supervisi", "approved"], ["Minta bukti tambahan", "needs_more_evidence"], ["Rekomendasikan belum dientrust", "not_entrusted"]], {}, class: "rounded-lg border-gray-300" %>
          <%= f.collection_select :supervision_level_id, SupervisionLevel.joins(:supervision_scale_version).where(supervision_scale_versions: { active: true, use_case: "prospective_entrustment" }), :id, :label, { include_blank: "Level target (wajib saat disetujui)" }, class: "rounded-lg border-gray-300" %>
          <%= f.text_area :notes, rows: 2, placeholder: "Alasan / catatan panel", class: "rounded-lg border-gray-300 sm:col-span-2" %>
          <%= f.submit "Kirim rekomendasi panel", class: "rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white sm:col-span-2" %>
        <% end %>
      <% end %>
    </article>
  <% end %>
  <% if @promotions.empty? %><p class="rounded-xl bg-white p-5 text-sm text-gray-500">Belum ada mahasiswa yang siap atau menunggu tinjauan EPA.</p><% end %>
</div>
