<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Portfolio Saya</h1>
  <%= link_to "Unduh CSV", export_portfolio_path,
        class: "text-sm bg-indigo-50 text-indigo-700 font-medium px-4 py-2 rounded-xl hover:bg-indigo-100" %>
</div>

<div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-gray-500 uppercase">Total Kegiatan</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total %></p>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-sky-600 uppercase">Klinis</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @klinis_count %></p>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-emerald-600 uppercase">Non-Klinis</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @non_klinis_count %></p>
  </div>
</div>

<section id="selected-portfolio" class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-800">Portofolio Terpilih</h2>
      <p class="mt-1 text-xs text-gray-500">Pilih artefak yang sudah ditelaah. Portofolio privat secara default; sumber tetap berada di Logbook atau Koleksi Bukti.</p>
    </div>
    <% if UserAssignment.active.exists?(user: current_user, assignment_role: "artifact_reviewer") %>
      <%= link_to "Antrean telaah artefak", artifact_submissions_path, class: "text-sm font-medium text-indigo-700 hover:underline" %>
    <% end %>
  </div>
  <% if @portfolio_selections.any? %>
    <div class="mt-3 divide-y divide-gray-100">
      <% @portfolio_selections.each do |selection| %>
        <article class="flex flex-wrap items-center justify-between gap-3 py-3">
          <div>
            <p class="text-sm font-medium text-gray-800"><%= selection.artifact_submission.source_title %></p>
            <p class="text-xs text-gray-500"><%= selection.artifact_submission.selection_reason %> · <%= selection.visibility == "private" ? "Privat" : "Dapat dilihat penelaah yang berwenang" %></p>
          </div>
          <%= button_to "Keluarkan", portfolio_selection_path(selection), method: :delete,
            class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">Belum ada artefak terpilih.</p>
  <% end %>
</section>

<section id="artifact-submissions" class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
  <h2 class="text-sm font-semibold text-gray-800">Ajukan artefak untuk ditelaah</h2>
  <p class="mt-1 text-xs text-gray-500">Kegiatan harus tervalidasi. Pengajuan tidak otomatis menjadi keputusan capaian kompetensi.</p>
  <% if @artifact_sources.any? %>
    <%= form_with model: ArtifactSubmission.new, class: "mt-3 grid gap-3" do |f| %>
      <%= f.select :source_type, @artifact_sources.map { |label, type, id| [label, "#{type}:#{id}"] },
        { prompt: "Pilih sumber artefak" }, { name: "artifact_submission[source_reference]", required: true, class: "rounded-lg border-gray-300 text-sm" } %>
      <%= f.text_area :selection_reason, required: true, minlength: 10, maxlength: 2000, rows: 2,
        placeholder: "Mengapa artefak ini bermakna bagi perkembangan kompetensi Anda?", class: "rounded-lg border-gray-300 text-sm" %>
      <%= f.text_area :reflection, maxlength: 5000, rows: 3,
        placeholder: "Refleksi (opsional): apa yang dipelajari dan tindak lanjut Anda?", class: "rounded-lg border-gray-300 text-sm" %>
      <%= f.submit "Ajukan untuk ditelaah", class: "w-fit rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">Belum ada logbook tervalidasi, refleksi, atau bukti tervalidasi yang dapat diajukan.</p>
  <% end %>
  <% if @artifact_submissions.any? %>
    <div class="mt-4 divide-y divide-gray-100">
      <% @artifact_submissions.each do |submission| %>
        <article class="flex flex-wrap items-start justify-between gap-3 py-3">
          <div>
            <p class="text-sm font-medium text-gray-800"><%= submission.source_title %> · <%= submission.status.humanize %></p>
            <p class="text-xs text-gray-500"><%= submission.selection_reason %></p>
            <% if submission.review_notes.present? %><p class="mt-1 text-xs text-gray-600">Catatan telaah: <%= submission.review_notes %></p><% end %>
          </div>
          <div class="flex gap-2">
            <% if submission.approved? && submission.portfolio_selection.blank? %>
              <%= form_with model: PortfolioSelection.new, url: portfolio_selections_path, class: "flex gap-2" do |f| %>
                <%= hidden_field_tag :artifact_submission_id, submission.id %>
                <%= f.select :visibility, [["Privat", "private"], ["Penelaah berwenang", "assigned_reviewers"]], {}, class: "rounded-lg border-gray-300 text-xs" %>
                <%= f.submit "Pilih", class: "rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white" %>
              <% end %>
            <% elsif submission.status == "rejected" %>
              <%= button_to "Ajukan ulang", resubmit_artifact_submission_path(submission), method: :patch,
                class: "rounded-lg border border-amber-300 px-3 py-1.5 text-xs font-medium text-amber-800" %>
            <% elsif submission.submitted? %>
              <%= button_to "Tarik", artifact_submission_path(submission), method: :delete,
                class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</section>

<% if @epa_observations.any? %>
  <section class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
    <h2 class="text-sm font-semibold text-gray-800">Observasi formatif EPA</h2>
    <p class="mt-1 text-xs text-gray-500">Observasi ini mencatat kinerja pada kejadian tertentu; keputusan entrustment ditetapkan terpisah oleh Otoritas Akademik.</p>
    <div class="mt-3 divide-y divide-gray-100">
      <% @epa_observations.each do |observation| %>
        <article class="py-3">
          <div class="flex flex-wrap justify-between gap-2 text-sm"><span class="font-medium"><%= observation.epa.code %> · <%= observation.epa.title %></span><span class="text-xs text-gray-500"><%= l(observation.observed_at, format: :long) %> · <%= observation.complexity.humanize %></span></div>
          <p class="mt-1 text-sm text-gray-700"><%= observation.narrative %></p>
          <p class="mt-1 text-xs text-gray-500">Pengamat: <%= observation.observer.full_name %> · Supervisi yang diberikan: <%= observation.supervision_level.label %></p>
          <% if observation.safety_flag? %><p class="mt-1 text-xs <%= observation.safety_resolved_at.present? ? 'text-amber-700' : 'text-rose-700' %>"><%= observation.safety_resolved_at.present? ? "Tindak lanjut keselamatan dicatat" : "Flag keselamatan belum ditindaklanjuti" %></p><% end %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<% if @evidence_requirements.any? %>
  <section id="evidence-requirements" class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
    <h2 class="text-sm font-semibold text-gray-800">Bukti yang Diharapkan</h2>
    <p class="mt-1 text-xs text-gray-500">Bukti dari observasi EPA dicatat otomatis; tautkan sumber asesmen, WPBA, logbook, atau refleksi yang relevan. Kecukupan bukti terpisah dari keputusan ketercapaian kompetensi.</p>
    <div class="mt-3 divide-y divide-gray-100">
      <% @evidence_requirements.each do |requirement| %>
        <% progress = EvidenceRequirementProgress.new(requirement, student: @student).call %>
        <% version = progress.requirement_version %>
        <% rule = version&.fulfillment_rule || requirement.fulfillment_rule %>
        <% source_type = version&.source_type || requirement.source_type %>
        <div class="py-3">
          <div class="flex items-center justify-between gap-3 text-sm">
            <span class="font-medium text-gray-700"><%= requirement.competency_indicator&.description || requirement.competency_item&.title || requirement.epa&.title %> · <%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(source_type) %><%= " · Kritis" if rule["critical"] %></span>
            <span class="text-xs text-gray-500"><%= progress.record_count %>/<%= progress.required_count %> bukti valid · <%= progress.status.to_s.humanize %></span>
          </div>
          <% if rule["minimum_pass"].to_i.positive? || rule["minimum_distinct_cases"].to_i.positive? || rule["minimum_distinct_assessors"].to_i.positive? || rule["minimum_distinct_opportunities"].to_i.positive? || rule["minimum_distinct_dates"].to_i.positive? || rule["minimum_span_days"].to_i.positive? %>
            <p class="mt-1 text-[11px] text-gray-500">Lulus: <%= progress.pass_count %>/<%= rule["minimum_pass"].to_i %> · Kasus berbeda: <%= progress.case_count %>/<%= rule["minimum_distinct_cases"].to_i %> · Penilai berbeda: <%= progress.assessor_count %>/<%= rule["minimum_distinct_assessors"].to_i %> · Kesempatan berbeda: <%= progress.opportunity_count %>/<%= rule["minimum_distinct_opportunities"].to_i %> · Tanggal berbeda: <%= progress.distinct_date_count %>/<%= rule["minimum_distinct_dates"].to_i %> · Rentang: <%= progress.span_days %>/<%= rule["minimum_span_days"].to_i %> hari</p>
          <% end %>
          <% if rule["additional_criteria"].present? %><p class="mt-1 text-[11px] text-gray-500"><%= rule["additional_criteria"] %></p><% end %>
          <% if version.present? %><p class="mt-1 text-[11px] text-gray-400">Versi Bukti yang Diharapkan: <%= version.version %></p><% end %>
        <% if @evidence_sources.fetch(source_type, []).any? %>
            <%= form_with url: evidence_requirement_evidence_records_path(requirement), scope: :evidence_record, class: "mt-2 flex flex-wrap gap-2" do |f| %>
              <%= f.select :source_key, @evidence_sources.fetch(source_type, []), { prompt: "Pilih bukti aktual" }, class: "min-w-[16rem] rounded-lg border-gray-300 text-xs" %>
              <%= f.date_field :evidence_date, value: Date.current, class: "rounded-lg border-gray-300 text-xs" %>
              <%= f.submit "Tautkan", class: "rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white cursor-pointer" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @total.positive? %>
  <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-sm font-semibold text-gray-700 mb-3">Tren 6 Bulan Terakhir</p>
    <%= column_chart @monthly_counts, colors: [ "#4f46e5" ], height: "220px" %>
  </div>

  <% if @type_counts.any? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-sm font-semibold text-gray-700 mb-3">Jenis Kegiatan Terbanyak</p>
      <%= bar_chart @type_counts, colors: [ "#6366f1" ], height: "220px" %>
    </div>
  <% end %>
<% else %>
  <p class="mt-6 text-sm text-gray-400">Belum ada kegiatan untuk ditampilkan. Mulai catat di Logbook.</p>
<% end %>

<%= link_to "← Kembali ke Logbook", activity_logs_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
