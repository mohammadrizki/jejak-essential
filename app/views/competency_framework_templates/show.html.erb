<div class="max-w-4xl">
  <%= link_to "← Pustaka Template", competency_framework_templates_path, class: "text-sm text-indigo-600 hover:underline" %>
  <div class="mt-3 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Template v<%= @template.template_version %></p>
    <h1 class="mt-1 text-xl font-bold text-gray-900"><%= @template.name %></h1>
    <p class="mt-2 text-sm text-gray-600"><%= @template.description %></p>
    <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
      <div><dt class="text-xs text-gray-500">Sumber acuan</dt><dd class="font-medium text-gray-800"><%= @template.source_name %> · versi <%= @template.source_version %></dd></div>
      <div><dt class="text-xs text-gray-500">Jenjang awal</dt><dd class="font-medium text-gray-800"><%= @template.education_stage || "Dipilih saat membuat salinan" %></dd></div>
    </dl>
    <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900"><%= @template.attribution %></p>
    <div class="mt-4 space-y-2">
      <% @template.domains.each do |domain| %>
        <div class="rounded-lg border border-gray-100 p-3">
          <p class="font-semibold text-gray-800"><%= domain["code"] %> · <%= domain["title"] %></p>
          <p class="mt-1 text-xs text-gray-500"><%= domain["description"] %></p>
          <% domain.fetch("indicators", []).each do |indicator| %>
            <p class="ml-4 mt-2 text-xs text-gray-700"><strong><%= indicator["code"] %></strong> · <%= indicator["description"] %><%= " — #{indicator['performance_level']}" if indicator["performance_level"].present? %></p>
          <% end %>
          <% domain.fetch("subcompetencies", []).each do |sub| %>
            <p class="ml-4 mt-2 text-sm text-gray-700"><%= sub["code"] %> · <%= sub["title"] %></p>
            <% sub.fetch("indicators", []).each do |indicator| %>
              <p class="ml-8 mt-1 text-xs text-gray-700"><strong><%= indicator["code"] %></strong> · <%= indicator["description"] %><%= " — #{indicator['performance_level']}" if indicator["performance_level"].present? %></p>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% if @template.domains.empty? %><p class="rounded-lg bg-gray-50 p-4 text-sm text-gray-500">Template ini kosong; susun domain, subkompetensi, dan indikator setelah membuat salinan.</p><% end %>
    </div>
  </div>

  <% if @study_programs.present? %>
    <section class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-gray-200">
      <h2 class="text-sm font-semibold text-gray-800">Gunakan template</h2>
      <% if @duplicate_errors.present? %><p class="mt-2 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-800"><%= @duplicate_errors.to_sentence %></p><% end %>
      <%= form_with url: duplicate_competency_framework_template_path(@template.key), method: :post, class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
        <div>
          <%= f.label :name, "Nama framework baru", class: "mb-1 block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name, value: params[:name].presence || @template.name, required: true, class: "block w-full rounded-lg border-gray-300 text-sm" %>
        </div>
        <div>
          <%= f.label :study_program_id, "Program studi tujuan", class: "mb-1 block text-sm font-medium text-gray-700" %>
          <%= f.collection_select :study_program_id, @study_programs, :id, :name, { selected: params[:study_program_id], prompt: "Pilih program studi" }, { required: true, class: "block w-full rounded-lg border-gray-300 text-sm" } %>
        </div>
        <p class="text-xs text-gray-500 sm:col-span-2">Salinan berstatus draf. Blueprint Asesmen, EPA, Syarat Bukti, hasil asesmen, dan capaian tidak termasuk dalam template.</p>
        <%= f.submit "Buat salinan draf", class: "justify-self-start rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 cursor-pointer" %>
      <% end %>
    </section>
  <% elsif !current_user.has_role?("admin") %>
    <p class="mt-4 rounded-xl bg-gray-50 p-4 text-sm text-gray-600">Pratinjau dapat dilihat semua pengguna yang masuk. Hanya admin yang dapat membuat salinan dan memilih program studi tujuan.</p>
  <% end %>
</div>
