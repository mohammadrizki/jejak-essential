<div class="mx-auto max-w-5xl space-y-5 px-4 py-6">
  <header class="flex items-start justify-between gap-4">
    <div><h1 class="text-2xl font-bold">Peran & Hak Akses</h1>
      <p class="mt-1 text-sm text-gray-600">Peran menentukan tindakan yang diizinkan. Assignment dosen/preseptor tetap menentukan mahasiswa atau kegiatan yang boleh dinilai.</p></div>
    <%= link_to "Tambah peran", new_role_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
  </header>
  <% @roles.each do |role| %>
    <article class="rounded-xl border bg-white p-4">
      <div class="flex items-center justify-between gap-3">
        <div><h2 class="font-semibold"><%= role.name %> <span class="text-xs text-gray-500">(<%= role.code %>)</span></h2>
          <p class="mt-1 text-xs text-gray-600"><%= role.user_roles.size %> pengguna mendapat peran · <%= role.role_permissions.size %> hak akses</p></div>
        <div class="flex gap-2"><%= link_to "Kelola", edit_role_path(role), class: "rounded border px-3 py-1.5 text-sm" %>
          <% unless role.system_role? || role.user_roles.exists? %><%= button_to "Hapus", role_path(role), method: :delete, form: { data: { turbo_confirm: "Hapus peran ini?" } }, class: "rounded border border-rose-300 px-3 py-1.5 text-sm text-rose-700" %><% end %></div>
      </div>
      <ul class="mt-3 flex flex-wrap gap-2"><% role.role_permissions.includes(:system_permission).each do |grant| %>
        <li class="rounded bg-slate-100 px-2 py-1 text-xs"><%= grant.system_permission.name %> · <%= grant.scope_level == "system" ? "sistem" : "program studi" %></li>
      <% end %></ul>
    </article>
  <% end %>
</div>
