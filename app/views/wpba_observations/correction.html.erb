<div class="mx-auto max-w-xl space-y-5 px-4 py-6"><h1 class="text-2xl font-bold">Koreksi observasi WPBA</h1><p class="text-sm text-gray-600">Observasi awal akan dipertahankan sebagai riwayat. Koreksi tidak dihitung sebagai kesempatan independen baru.</p><%= form_with url: create_correction_wpba_observation_path(@observation), class: "space-y-3" do |f| %><%= f.label :correction_reason, "Alasan koreksi (minimal 10 karakter)", class: "block text-sm font-medium" %><%= f.text_area :correction_reason, required: true, minlength: 10, maxlength: 1000, rows: 4, class: "w-full rounded-lg border-gray-300" %><%= f.submit "Buat draf koreksi", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %><% end %></div>
