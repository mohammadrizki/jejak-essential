<div class="flex items-center justify-between">
  <h1 class="text-xl font-bold text-gray-900">Blueprint Asesmen</h1>
  <%= link_to "+ Blueprint Baru", new_assessment_blueprint_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>
<p class="text-sm text-gray-400 mt-1">Rencana cakupan asesmen — seberapa besar bobot tiap ranah kompetensi.</p>

<div class="mt-4 space-y-2">
  <% @assessment_blueprints.each do |blueprint| %>
    <div class="flex flex-wrap items-center gap-3 rounded-2xl bg-white p-4 ring-1 ring-gray-200 hover:ring-indigo-300">
      <%= link_to assessment_blueprint_path(blueprint), class: "min-w-0 flex-1" do %>
        <div class="flex items-center justify-between gap-2">
          <p class="font-semibold text-gray-800"><%= blueprint.name %> <span class="font-normal text-gray-500">· <%= blueprint.study_program.name %></span></p>
          <span class="shrink-0 text-xs font-bold px-2 py-0.5 rounded-full <%= blueprint.total_weight == 100 ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
            <%= blueprint.total_weight.round(1) %>%
          </span>
        </div>
        <p class="text-xs text-gray-400 mt-1"><%= blueprint.description %></p>
      <% end %>
      <% if policy(blueprint).duplicate? %>
        <%= link_to "Duplikasi", duplicate_assessment_blueprint_path(blueprint), class: "shrink-0 rounded-lg border border-indigo-200 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-50" %>
      <% end %>
    </div>
  <% end %>
  <% if @assessment_blueprints.empty? %>
    <p class="text-sm text-gray-400">Belum ada blueprint asesmen.</p>
  <% end %>
</div>
