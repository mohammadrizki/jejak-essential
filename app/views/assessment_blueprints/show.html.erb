<div class="max-w-2xl">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @assessment_blueprint.name %></h1>
      <p class="text-sm text-gray-400 mt-1"><%= @assessment_blueprint.description %></p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
    <% if policy(@assessment_blueprint).update? %>
      <div class="flex items-center gap-2 shrink-0">
        <%= link_to "Sunting", edit_assessment_blueprint_path(@assessment_blueprint), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
        <%= button_to "Hapus", assessment_blueprint_path(@assessment_blueprint), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus blueprint ini?" } } %>
      </div>
    <% end %>
    <% if policy(@assessment_blueprint).duplicate? %>
      <%= link_to "Duplikasi Blueprint", duplicate_assessment_blueprint_path(@assessment_blueprint), class: "rounded-lg border border-indigo-200 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-50" %>
    <% end %>
    </div>
  </div>

  <% if @assessment_blueprint.study_program.showcase? %>
    <section class="mt-3 rounded-xl border border-sky-200 bg-sky-50 p-3 text-xs text-sky-900">
      <strong>Contoh implementasi (read-only).</strong> Komponen, bobot, dan pemetaan ini hanya ilustrasi adaptasi lokal CanMEDS. Duplikasi Blueprint ke prodi Anda untuk meninjau dan menyesuaikannya sebagai draf.
    </section>
  <% end %>

  <% if @blueprint_version %>
    <section class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-800">Komponen asesmen · versi <%= @blueprint_version.version %> · <%= @blueprint_version.status %></h2>
          <% if @blueprint_version.change_notes.present? %><p class="mt-1 text-xs text-gray-500"><%= @blueprint_version.change_notes %></p><% end %>
        </div>
        <% if policy(@assessment_blueprint).update? && @assessment_blueprint.draft_version.nil? %>
          <%= button_to "Buat versi baru", new_version_assessment_blueprint_path(@assessment_blueprint), method: :post, class: "rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white" %>
        <% end %>
        <% if policy(@assessment_blueprint).update? && @blueprint_version.status == "draft" %>
          <%= button_to "Terbitkan versi ini", publish_version_assessment_blueprint_path(@assessment_blueprint), method: :patch, class: "rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white", form: { data: { turbo_confirm: "Terbitkan versi ini dan arsipkan versi sebelumnya?" } } %>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-gray-500">Bukti yang Diharapkan menetapkan jenis dan jumlah bukti yang perlu ditautkan mahasiswa di Portfolio untuk komponen asesmen ini.</p>
      <div class="mt-3 divide-y divide-gray-100">
        <% @blueprint_version.blueprint_items.includes(:assessment_method, :competency_items, :epas).each do |item| %>
          <div class="flex justify-between gap-3 py-3 text-sm">
            <div><p class="font-medium text-gray-800"><%= item.title %> <span class="text-xs text-gray-400">(<%= item.code %> · <%= item.assessment_method.name %>)</span></p>
              <p class="mt-1 text-xs text-gray-500"><%= item.competency_items.map(&:title).join(", ").presence || "Belum dipetakan" %><%= " · EPA: #{item.epas.map(&:title).join(', ')}" if item.epas.any? %></p></div>
            <% if @blueprint_version.status == "draft" && policy(@assessment_blueprint).update? %>
              <%= button_to "Hapus", assessment_blueprint_blueprint_item_path(@assessment_blueprint, item), method: :delete, class: "text-xs text-rose-600" %>
            <% end %>
          </div>
          <% if @blueprint_version.status == "draft" && policy(@assessment_blueprint).update? %>
            <%= form_with url: blueprint_item_evidence_requirements_path(item), scope: :evidence_requirement, class: "mb-2 flex flex-wrap gap-2 items-center" do |f| %>
              <% if item.competency_items.first %>
                <%= f.hidden_field :competency_item_id, value: item.competency_items.first.id %>
                <% indicator_options = item.blueprint_item_competencies.includes(:competency_item, :competency_indicator).filter_map { |mapping| ["#{mapping.competency_item.title} · #{mapping.competency_indicator.code}", mapping.competency_indicator_id] if mapping.competency_indicator } %>
                <% if indicator_options.any? %><%= f.select :competency_indicator_id, options_for_select(indicator_options), { include_blank: "Indikator (opsional)" }, class: "rounded-lg border-gray-300 text-xs" %><% end %>
              <% elsif item.epas.first %>
                <%= f.hidden_field :epa_id, value: item.epas.first.id %>
              <% end %>
              <%= f.select :source_type, EvidenceRequirement::SOURCE_TYPES.map { |value| [EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(value), value] }, {}, class: "rounded-lg border-gray-300 text-xs" %>
              <%= f.number_field :required_count, min: 1, value: 1, placeholder: "Bukti valid minimal", class: "w-28 rounded-lg border-gray-300 text-xs" %>
              <%= render "evidence_requirements/fulfillment_fields", indicator: indicator_options&.any? %>
              <%= f.submit "Tambah bukti yang diharapkan", class: "text-xs text-indigo-600 font-semibold cursor-pointer" %>
            <% end %>
          <% end %>
          <% item.evidence_requirements.each do |requirement| %>
            <div class="mb-2 flex items-center gap-2 text-xs text-gray-500"><span>Bukti: <%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(requirement.source_type) %> × <%= requirement.required_count %></span>
              <% if @blueprint_version.status == "draft" && policy(@assessment_blueprint).update? %>
                <%= render "evidence_requirements/actions", edit_path: edit_blueprint_item_evidence_requirement_path(item, requirement), path: blueprint_item_evidence_requirement_path(item, requirement) %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <% if @blueprint_version.status == "draft" && policy(@assessment_blueprint).update? %>
        <%= form_with url: assessment_blueprint_blueprint_items_path(@assessment_blueprint), scope: :blueprint_item, class: "mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 border-t border-gray-100 pt-4" do |f| %>
          <%= f.text_field :code, placeholder: "Kode komponen", required: true, class: "rounded-lg border-gray-300 text-sm" %>
          <%= f.text_field :title, placeholder: "Nama komponen asesmen", required: true, class: "rounded-lg border-gray-300 text-sm" %>
          <%= f.collection_select :assessment_method_id, @assessment_methods, :id, :name, { prompt: "Metode asesmen" }, { required: true, class: "rounded-lg border-gray-300 text-sm" } %>
          <%= f.number_field :target_count, min: 1, placeholder: "Jumlah target", class: "rounded-lg border-gray-300 text-sm" %>
          <%= f.select :competency_item_ids, options_from_collection_for_select(@blueprint_version.competency_framework.competency_items.order(:position), :id, :title), { include_hidden: false, include_blank: "Pilih kompetensi" }, { multiple: true, class: "rounded-lg border-gray-300 text-sm" } %>
          <%= f.select :competency_indicator_ids, options_from_collection_for_select(@blueprint_version.competency_framework.competency_indicators.includes(:competency_item).order(:position), :id, ->(indicator) { "#{indicator.competency_item.title} · #{indicator.code || indicator.description.truncate(50)}" }), { include_hidden: false, include_blank: "Pilih indikator" }, { multiple: true, class: "rounded-lg border-gray-300 text-sm" } %>
          <% if @available_epas.any? %>
            <%= f.select :epa_ids, options_from_collection_for_select(@available_epas, :id, :title), { include_hidden: false, include_blank: "Pilih EPA" }, { multiple: true, class: "rounded-lg border-gray-300 text-sm" } %>
            <%= f.select :epa_purpose, BlueprintItemEpa::PURPOSES.map { |value| [value.humanize, value] }, {}, class: "rounded-lg border-gray-300 text-sm" %>
            <%= f.number_field :epa_expected_level, min: 1, max: 5, placeholder: "Level EPA", class: "rounded-lg border-gray-300 text-sm" %>
            <%= f.collection_select :epa_supervision_level_id,
                SupervisionLevel.joins(:supervision_scale_version).includes(:supervision_scale_version)
                  .where(supervision_scale_versions: { active: true, use_case: "prospective_entrustment" }),
                :id, ->(level) { "#{level.supervision_scale_version.name} v#{level.supervision_scale_version.version_label} · #{level.ordinal} — #{level.label}" },
                { include_blank: "Skala target entrustment (opsional)" }, class: "rounded-lg border-gray-300 text-sm" %>
          <% end %>
          <%= f.submit "Tambah komponen", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white cursor-pointer" %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <div class="flex items-center justify-between mb-3">
      <p class="text-sm font-semibold text-gray-700">Peta Bobot Kompetensi</p>
      <span class="text-xs font-bold px-2 py-0.5 rounded-full <%= @assessment_blueprint.weights_complete? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
        Total <%= @assessment_blueprint.total_weight.round(1) %>%
        <% unless @assessment_blueprint.weights_complete? %>
          <span class="font-normal">· sisa <%= @assessment_blueprint.remaining_weight %>%</span>
        <% end %>
      </span>
    </div>
    <% weights = @assessment_blueprint.weight_by_competency_item %>
    <% if weights.present? %>
      <div data-controller="radar-chart"
           data-radar-chart-labels-value="<%= weights.keys.map(&:title).to_json %>"
           data-radar-chart-datasets-value="<%= [ { label: "Bobot (%)", data: weights.values, borderColor: "#4f46e5", backgroundColor: "rgba(79,70,229,0.15)" } ].to_json %>"
           data-radar-chart-max-value="<%= @assessment_blueprint.competency_weight_chart_max %>">
        <canvas data-radar-chart-target="canvas" height="260"></canvas>
      </div>

      <ul class="mt-4 divide-y divide-gray-100">
        <% @assessment_blueprint.competency_weight_mappings.each do |mapping| %>
          <li class="flex items-center justify-between py-2 text-sm">
            <span class="text-gray-700"><%= mapping.competency_item.title %></span>
            <div class="flex items-center gap-2">
              <span class="font-semibold text-gray-800"><%= mapping.weight.to_f.round(1) %>%</span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada peta bobot.</p>
    <% end %>

    <p class="mt-3 text-xs text-gray-400">Bobot lama dipertahankan sebagai riwayat. Komponen asesmen dan pemetaan baru dikelola pada versi blueprint.</p>
  </div>

  <% if @assessment_blueprint.learning_outcomes.present? %>
    <div class="mt-4 bg-indigo-50/50 rounded-2xl ring-1 ring-indigo-100 p-5">
      <p class="text-xs font-semibold text-indigo-500 uppercase mb-2">Capaian Pembelajaran</p>
      <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
        <% @assessment_blueprint.learning_outcomes.each do |outcome| %>
          <li><%= outcome %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= link_to "← Kembali ke Daftar Blueprint", assessment_blueprints_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
