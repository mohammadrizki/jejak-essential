<div class="max-w-xl">
  <h1 class="text-xl font-bold text-gray-900 mb-2">Sunting indikator</h1>
  <p class="text-sm text-gray-500 mb-6">Kompetensi: <%= @competency_item.title %></p>

  <%= form_with model: @indicator,
        url: competency_item_competency_indicator_path(@competency_item, @indicator),
        method: :patch, class: "space-y-4" do |f| %>
    <% if @indicator.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm"><%= @indicator.errors.full_messages.to_sentence %></div>
    <% end %>
    <div>
      <%= f.label :code, "Kode (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :code, class: "block w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <div>
      <%= f.label :description, "Indikator terukur", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_area :description, required: true, rows: 3, class: "block w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <div>
      <%= f.label :performance_level, "Standar kinerja (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :performance_level, class: "block w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <div class="flex items-center gap-3">
      <%= f.submit "Simpan perubahan", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white cursor-pointer" %>
      <%= link_to "Batal", competency_framework_path(@competency_item.competency_framework), class: "text-sm text-gray-500" %>
    </div>
  <% end %>
</div>
