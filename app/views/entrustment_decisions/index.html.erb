<% content_for :title, "Peta EPA & Tingkat Entrustment" %>
<% level_cls = { nil => "bg-gray-100 text-gray-500", 1 => "bg-rose-100 text-rose-700", 2 => "bg-amber-100 text-amber-700", 3 => "bg-sky-100 text-sky-700", 4 => "bg-emerald-100 text-emerald-700", 5 => "bg-indigo-100 text-indigo-700" } %>
<div class="space-y-5">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Peta EPA & Tingkat Entrustment</h1>
    <p class="text-sm text-gray-500 mt-0.5">Observasi formatif, kecukupan bukti, dan keputusan Otoritas Akademik ditampilkan sebagai tahapan terpisah.</p>
  </div>

  <% if @framework.nil? %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 text-sm text-gray-400">Belum ada kerangka kompetensi. Admin membuatnya di Konfigurasi → Kerangka Kompetensi.</div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @map.each do |epa, decision| %>
        <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 flex flex-col">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-semibold text-gray-800"><%= epa.title %></p>
            <span class="shrink-0 text-lg font-black h-9 w-9 rounded-full flex items-center justify-center <%= level_cls[decision&.level] %>"><%= decision&.level || "–" %></span>
          </div>
          <% if decision %>
            <p class="text-xs text-gray-600 mt-1"><%= decision.level_label %></p>
            <% if decision.supervision_level %>
              <p class="text-[10px] text-gray-400 mt-1"><%= decision.supervision_level.supervision_scale_version.name %> · versi <%= decision.supervision_level.supervision_scale_version.version_label %></p>
            <% end %>
            <p class="text-xs text-gray-500 mt-2 whitespace-pre-line flex-1"><%= decision.justification %></p>
            <p class="text-[10px] text-gray-400 mt-2"><%= decision.decided_by.full_name %> · <%= l(decision.created_at, format: :short) %><%= " · dari kasus" if decision.clinical_case %></p>
          <% else %>
            <p class="text-xs text-gray-400 mt-1 flex-1">Belum ada penilaian.</p>
          <% end %>
          <div class="mt-3 flex flex-wrap gap-3">
            <%= link_to "Lihat observasi formatif", epa_observations_path(student_id: @student.id), class: "text-xs font-semibold text-indigo-700 hover:underline" %>
            <% if @student.clinical_rotations.ongoing.exists?(preceptor: current_user) %>
              <%= link_to "Catat observasi", new_epa_observation_path(student_id: @student.id, epa_id: epa.id), class: "text-xs font-semibold text-indigo-700 hover:underline" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if @map.empty? %>
      <div class="rounded-2xl bg-white p-5 text-sm text-gray-500 ring-1 ring-gray-200">Peta entrustment EPA tersedia untuk tahap Profesi, Spesialis, dan Subspesialis.</div>
    <% end %>

    <% if @history.any? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-800 mb-3">Keputusan Otoritas Akademik</p>
        <div class="divide-y divide-gray-100">
          <% @history.each do |d| %>
            <div class="py-2 flex items-start gap-3 text-sm <%= 'opacity-50' if d.superseded_at %>">
              <span class="shrink-0 text-xs font-black h-6 w-6 rounded-full flex items-center justify-center <%= level_cls[d.level] %>"><%= d.level %></span>
              <div class="min-w-0">
                <p class="text-gray-800"><span class="font-semibold"><%= d.epa_title %></span> <span class="text-xs text-gray-400">· <%= d.decided_by.full_name %> · <%= l(d.created_at, format: :short) %><%= d.revoked? ? " · dicabut (verifikasi dibatalkan)" : (" · tergantikan" if d.superseded_at) %></span></p>
                <p class="text-xs text-gray-500"><%= d.justification %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
