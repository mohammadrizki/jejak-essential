<div class="mx-auto max-w-6xl space-y-5 px-4 py-6">
  <header>
    <h1 class="text-2xl font-bold text-gray-900">Penilaian & Validasi Bukti Eksternal</h1>
    <p class="mt-1 text-sm text-gray-600">Tinjau provenance dan konteks sebelum bukti impor dapat digunakan sebagai bukti tervalidasi. Bukti yang Anda impor sendiri tidak dapat Anda validasi.</p>
  </header>

  <% if @sources.empty? %>
    <p class="rounded-xl border border-gray-200 bg-white p-5 text-sm text-gray-600">Tidak ada bukti eksternal yang menunggu telaah dalam lingkup penugasan Anda.</p>
  <% end %>

  <div class="space-y-4">
    <% @sources.each do |source| %>
      <% provenance = source.metadata.to_h %>
      <article class="rounded-2xl border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="font-semibold text-gray-900"><%= source.student.full_name %> · <%= source.instrument_code.presence || source.source_system.humanize %></h2>
            <p class="text-sm text-gray-600"><%= source.source_system %> · <%= source.source_record_id %> / <%= source.source_revision %> · <%= l(source.occurred_on) %></p>
            <p class="mt-1 text-sm text-gray-700"><%= source.feedback.presence || "Tidak ada umpan balik naratif dari sistem sumber." %></p>
          </div>
          <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Menunggu validasi</span>
        </div>
        <dl class="mt-4 grid gap-2 text-xs text-gray-600 sm:grid-cols-2">
          <div class="sm:col-span-2"><dt class="font-semibold">Syarat Bukti yang dituju</dt><dd><%= source.evidence_records.filter_map { |record| requirement = record.evidence_requirement; requirement&.competency_indicator&.title || requirement&.competency_item&.title || requirement&.epa&.title }.uniq.join("; ").presence || "Target tidak tersedia" %></dd></div>
          <div><dt class="font-semibold">Versi instrumen</dt><dd><%= source.instrument_version.presence || "Tidak dicantumkan" %></dd></div>
          <div><dt class="font-semibold">Penilai sumber</dt><dd><%= source.assessor&.full_name || "Tidak dipetakan" %></dd></div>
          <div><dt class="font-semibold">Batch impor</dt><dd><%= provenance["jejak_import_batch_id"].presence || "Integrasi langsung" %></dd></div>
          <div><dt class="font-semibold">Diimpor oleh</dt><dd><%= User.find_by(id: provenance["jejak_imported_by_id"])&.full_name || "Adapter tepercaya" %></dd></div>
          <div><dt class="font-semibold">Konteks asesmen</dt><dd><%= source.context.to_h.slice("rotation_id", "case_id", "complexity", "supervision", "station", "assessment_id").to_json %></dd></div>
          <div><dt class="font-semibold">Kolom provenance sumber</dt><dd><%= provenance.except("jejak_import_batch_id", "jejak_imported_by_id").keys.sort.join(", ").presence || "Tidak ada metadata tambahan" %></dd></div>
        </dl>
        <div class="mt-4 flex flex-wrap gap-2">
          <%= button_to "Validasi bukti", validate_evidence_source_path(source), method: :patch,
            class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
          <%= form_with url: reject_evidence_source_path(source), method: :patch, class: "flex flex-1 flex-wrap gap-2" do |form| %>
            <%= form.text_field :reason, required: true, minlength: 10, maxlength: 1000,
              placeholder: "Alasan penolakan (minimal 10 karakter)", class: "min-w-56 flex-1 rounded-lg border-gray-300 text-sm" %>
            <%= form.submit "Tolak bukti", class: "rounded-lg border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</div>
