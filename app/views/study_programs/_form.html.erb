<%= form_with model: study_program, class: "space-y-4" do |f| %>
  <% if study_program.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= study_program.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div>
    <%= f.label :name, "Nama", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :code, "Kode", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :code, placeholder: "pssk", class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :level, "Jenjang", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :level, StudyProgram::LEVELS.invert, {}, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>
  <div>
    <%= f.label :epa_panel_quorum, "Jumlah persetujuan panel EPA", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.number_field :epa_panel_quorum, min: 1, max: 10, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    <p class="mt-1 text-xs text-gray-500">Hanya anggota yang ditugaskan sebagai anggota panel EPA dapat dihitung. Konsensus tidak tercapai bila jumlah anggota aktif belum memenuhi angka ini.</p>
  </div>
  <% if study_program.persisted? %>
    <div>
      <%= f.label :competency_framework_id, "Peta Kompetensi terpilih", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :competency_framework_id, @competency_frameworks, :id, :name, { include_blank: "Gunakan versi terbaru prodi" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      <p class="text-xs text-gray-400 mt-1">Pilihan hanya memuat versi Peta Kompetensi milik program studi ini.</p>
    </div>
  <% else %>
    <p class="text-xs text-gray-500">Setelah program studi dibuat, pilih atau duplikasi template menjadi Peta Kompetensi milik program ini.</p>
  <% end %>
  <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
<% end %>
