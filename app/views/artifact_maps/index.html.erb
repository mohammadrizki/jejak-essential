<% content_for :title, "Peta Artefak" %>
<div class="mx-auto max-w-6xl space-y-5">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Peta Artefak</h1>
      <p class="mt-1 max-w-3xl text-sm text-gray-500">Daftar artefak dan bukti yang diharapkan oleh program studi, diturunkan dari Blueprint Asesmen. Halaman ini menampilkan rancangan program, bukan progres mahasiswa.</p>
      <% if @study_program %>
        <p class="mt-2 text-sm font-medium text-slate-700"><%= @study_program.name %> · <%= @study_program.level_label %></p>
        <p class="text-xs text-slate-500">Peta Kompetensi aktif: <%= @framework&.name || "belum tersedia" %><% if @blueprint_version %> · Blueprint v<%= @blueprint_version.version %> (<%= @blueprint_version.status.humanize %>), memakai <%= @blueprint_framework.name %> v<%= @blueprint_framework.version %><% end %></p>
        <% if @study_program.showcase? %><p class="mt-1 text-xs text-sky-700">Contoh demonstrasi read-only; seluruh Bukti yang Diharapkan di bawah merupakan ilustrasi lokal.</p><% end %>
      <% end %>
    </div>
    <%= link_to "Bukti yang Diharapkan", (@read_only ? portfolio_path(section: "evidence-requirements", anchor: "evidence-requirements") : evidence_requirements_path), class: "rounded-lg border border-indigo-200 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-50" %>
  </header>

  <% if @study_programs.many? && !@read_only %>
    <%= form_with url: artifact_map_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
      <%= label_tag :study_program_id, "Program studi", class: "text-sm font-medium text-gray-700" %>
      <%= select_tag :study_program_id, options_from_collection_for_select(@study_programs, :id, :name, @study_program&.id), class: "rounded-lg border-gray-300 text-sm", onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <% if @study_program.nil? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">Akun ini belum terhubung dengan program studi, sehingga Peta Artefak program belum dapat ditampilkan.</div>
  <% elsif @framework.nil? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-600">Program studi ini belum memiliki Peta Kompetensi. Peta Artefak akan terbentuk dari Blueprint Asesmen dan Bukti yang Diharapkan setelah kerangka tersedia.</div>
  <% else %>
    <section class="space-y-3" aria-labelledby="blueprint-artifacts-heading">
      <div>
        <h2 id="blueprint-artifacts-heading" class="text-base font-bold text-slate-900">Artefak dari Blueprint Asesmen</h2>
        <p class="text-xs text-slate-500">Setiap komponen asesmen ditampilkan bersama kompetensi yang dipetakan dan bukti yang diharapkan.</p>
      </div>
      <% if @artifact_map.blueprint_entries.any? %>
        <div class="space-y-3">
          <% @artifact_map.blueprint_entries.each do |entry| %>
            <% blueprint_item = entry.blueprint_item %>
            <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="font-semibold text-slate-900"><%= blueprint_item.code %> · <%= blueprint_item.title %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= blueprint_item.assessment_method.name %> · Komponen Blueprint</p>
                </div>
                <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700"><%= blueprint_item.blueprint_version.status.humanize %></span>
              </div>
              <div class="mt-3 grid gap-3 md:grid-cols-2">
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Kompetensi / EPA terkait</h3>
                  <% if entry.targets.any? %>
                    <ul class="mt-1 space-y-1 text-sm text-slate-700"><% entry.targets.each do |target| %><li><%= target %></li><% end %></ul>
                  <% else %>
                    <p class="mt-1 text-sm text-amber-700">Belum dipetakan ke kompetensi atau EPA.</p>
                  <% end %>
                </div>
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Bukti yang Diharapkan</h3>
                  <% if entry.requirements.any? %>
                    <ul class="mt-1 space-y-2">
                      <% entry.requirements.each do |expected| %>
                        <% configuration = expected.configuration %>
                        <% rule = configuration.fetch("fulfillment_rule", {}) %>
                        <li class="rounded-lg bg-slate-50 p-3 text-sm text-slate-700">
                          <% if expected.targets.any? %><p class="text-xs text-slate-500"><%= expected.targets.join(" · ") %></p><% end %>
                          <p class="font-medium"><%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(configuration.fetch("source_type"), "Bukti") %> · minimal <%= artifact_required_count(configuration) %> bukti</p>
                          <p class="mt-1 text-xs text-slate-500"><%= artifact_fulfillment_summary(configuration) %></p>
                          <p class="mt-1 text-xs text-slate-500"><%= "Wajib" if configuration.fetch("is_mandatory", false) %><%= " · target #{configuration['due_stage'].humanize}" if configuration["due_stage"].present? %><%= " · komponen kritis" if rule["critical"] && !configuration.fetch("is_mandatory", false) %></p>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    <p class="mt-1 text-sm text-slate-500">Belum ada aturan bukti yang diharapkan untuk komponen ini.</p>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-500">Belum ada komponen pada versi Blueprint yang tersedia.</p>
      <% end %>
    </section>

    <section class="space-y-3" aria-labelledby="manual-artifacts-heading">
      <div>
        <h2 id="manual-artifacts-heading" class="text-base font-bold text-slate-900">Bukti yang Diharapkan manual program studi</h2>
        <p class="text-xs text-slate-500">Persyaratan aktif yang ditetapkan langsung pada kompetensi, indikator, atau EPA.</p>
      </div>
      <% if @artifact_map.manual_entries.any? %>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
          <table class="w-full min-w-[760px] text-left text-sm">
            <thead class="border-b border-slate-100 bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-3">Kompetensi / EPA</th><th class="px-4 py-3">Artefak yang diharapkan</th><th class="px-4 py-3">Aturan pemenuhan</th><th class="px-4 py-3">Tahap dan status</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              <% @artifact_map.manual_entries.each do |entry| %>
                <% requirement = entry.requirement %>
                <% configuration = entry.configuration %>
                <tr class="align-top">
                  <td class="px-4 py-3 text-slate-700"><%= entry.targets.join(" · ") %></td>
                  <td class="px-4 py-3"><p class="font-medium text-slate-800"><%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(configuration.fetch("source_type"), "Bukti") %></p><p class="mt-1 text-xs text-slate-500">Minimal <%= artifact_required_count(configuration) %> bukti<%= " · wajib" if configuration.fetch("is_mandatory", false) %></p></td>
                  <td class="px-4 py-3 text-xs text-slate-600"><%= artifact_fulfillment_summary(configuration) %></td>
                  <td class="px-4 py-3 text-xs text-slate-600"><%= configuration["due_stage"].present? ? configuration["due_stage"].humanize : "Tidak ditentukan" %><span class="mt-1 block font-medium text-emerald-700"><%= configuration.fetch("status", requirement.status).humanize %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-500">Belum ada bukti yang diharapkan secara manual pada Peta Kompetensi atau EPA program studi ini.</p>
      <% end %>
    </section>
  <% end %>
</div>
