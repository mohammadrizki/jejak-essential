<% content_for :title, "Peta Artefak" %>
<div class="max-w-6xl">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Peta Artefak</h1>
      <p class="mt-1 max-w-3xl text-sm text-gray-500">Peta ini merupakan tampilan turunan dari indikator kompetensi, Blueprint Asesmen, dan Syarat Bukti. Tidak ada master artefak terpisah.</p>
    </div>
    <%= link_to "Syarat Bukti", evidence_requirements_path, class: "rounded-lg border border-indigo-200 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-50" %>
  </div>

  <% if @study_programs.any? %>
    <%= form_with url: artifact_map_path, method: :get, class: "mt-4" do %>
      <%= label_tag :study_program_id, "Program studi", class: "mr-2 text-sm font-medium text-gray-700" %>
      <%= select_tag :study_program_id, options_from_collection_for_select(@study_programs, :id, :name, @study_program&.id), class: "rounded-lg border-gray-300 text-sm", onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <% if @framework %>
    <div class="mt-4 overflow-x-auto rounded-2xl bg-white ring-1 ring-gray-200">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr><th class="px-4 py-3">Ranah / subkompetensi</th><th class="px-4 py-3">Indikator & standar kinerja</th><th class="px-4 py-3">Blueprint Asesmen</th><th class="px-4 py-3">Syarat Bukti</th></tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @indicators.each do |indicator| %>
            <% item = indicator.competency_item %>
            <% mappings = @mappings_by_code.fetch([item.code, indicator.code], []) + @mappings_by_code.fetch([item.code, nil], []) %>
            <% requirements = indicator.evidence_requirements.select { |r| r.status == "active" } + item.evidence_requirements.select { |r| r.status == "active" } %>
            <% requirements = requirements.uniq(&:id) %>
            <tr class="align-top">
              <td class="px-4 py-3 text-gray-700"><%= item.parent&.title || item.title %><% if item.parent %><span class="mt-1 block text-xs text-gray-400"><%= item.title %></span><% end %></td>
              <td class="px-4 py-3"><p class="font-medium text-gray-800"><%= indicator.code %> · <%= indicator.description %></p><p class="mt-1 text-xs text-gray-500"><%= indicator.performance_level.presence || "Standar kinerja belum diisi" %></p></td>
              <td class="px-4 py-3 text-gray-600">
                <% if mappings.any? %>
                  <% mappings.each do |mapping| %>
                    <p><%= mapping.blueprint_item.code %> · <%= mapping.blueprint_item.title %></p>
                    <% mapping.blueprint_item.evidence_requirements.select { |r| r.status == "active" }.each do |requirement| %>
                      <p class="mt-1 text-xs text-gray-400"><%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(requirement.source_type) %> × <%= requirement.required_count %></p>
                    <% end %>
                  <% end %>
                <% else %><span class="text-xs text-gray-400">Belum dipetakan ke Blueprint</span><% end %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-600">
                <% if requirements.any? %>
                  <% requirements.each do |requirement| %><p><%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(requirement.source_type) %> × <%= requirement.required_count %><%= " · Kritis" if requirement.fulfillment_rule["critical"] %></p><% end %>
                <% else %><span class="text-gray-400">Belum ditetapkan</span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 rounded-xl bg-white p-5 text-sm text-gray-500 ring-1 ring-gray-200">Program studi ini belum memiliki Peta Kompetensi. Peta Artefak akan terbentuk setelah kerangka kompetensi tersedia.</p>
  <% end %>
</div>
