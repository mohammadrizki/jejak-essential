<%= form_with model: reflection_entry, class: "space-y-4" do |f| %>
  <% if reflection_entry.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= reflection_entry.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :entry_date, "Tanggal", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.date_field :entry_date,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :title, "Judul (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <% [
    [:what_happened, "Apa yang saya alami?"],
    [:what_learned, "Apa yang saya pelajari?"],
    [:what_to_improve, "Apa yang masih perlu saya perbaiki?"],
    [:next_action, "Apa yang akan saya lakukan selanjutnya?"]
  ].each do |attribute, prompt| %>
    <div>
      <%= f.label attribute, prompt, class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_area attribute, rows: 3,
        class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  <% end %>
  <% if reflection_entry.persisted? && reflection_entry.what_happened.blank? && reflection_entry.content.present? %>
    <div class="rounded-lg bg-slate-50 p-3 text-xs text-slate-600">Refleksi lama tetap dipertahankan: <%= truncate(reflection_entry.content, length: 240) %></div>
  <% end %>

  <div>
    <%= f.label :competency_item_ids, "Kompetensi terkait (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.collection_select :competency_item_ids, @competency_items, :id, :title,
      { include_hidden: false }, multiple: true,
      class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 text-sm" %>
    <p class="mt-1 text-xs text-gray-400">Hanya kompetensi dari Peta Kompetensi program studi Anda yang dapat dipilih.</p>
  </div>

  <div>
    <%= f.label :evidence_source_ids, "Bukti yang direfleksikan (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.collection_select :evidence_source_ids, @evidence_sources, :id,
      ->(source) { "#{l(source.occurred_on, format: :long)} · #{source.instrument_code.presence || source.source_type.humanize} · #{source.validation_status.humanize}" },
      { include_hidden: false }, multiple: true,
      class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 text-sm" %>
    <p class="mt-1 text-xs text-gray-400">Tautan ini hanya memberi konteks refleksi; tidak membuat atau menghitung ulang bukti.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :activity_log_id, "Tautkan ke Kegiatan (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :activity_log_id, @activity_logs, :id, :title, { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :clinical_case_id, "Tautkan ke Kasus Klinis (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :clinical_case_id, @clinical_cases, :id, :chief_complaint, { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <%= f.submit "Simpan Refleksi", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
<% end %>
