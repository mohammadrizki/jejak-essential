<div class="mx-auto max-w-5xl space-y-5 px-4 py-6">
  <header><h1 class="text-2xl font-bold"><%= @instrument.name %></h1><p class="text-sm text-gray-600"><%= @instrument.code %> · <%= @instrument.instrument_type.humanize %></p></header>
  <section class="rounded-2xl border border-gray-200 bg-white p-5">
    <h2 class="font-semibold">Buat versi baru</h2>
    <p class="mt-1 text-sm text-gray-500">Definisi JSON menyimpan komponen, skala, aturan validasi, dan catatan versi instrumen.</p>
    <%= form_with scope: :version, url: admin_wpba_instrument_versions_path(@instrument), class: "mt-3 grid gap-3" do |f| %>
      <%= f.text_field :version_label, required: true, placeholder: "Nomor versi, misalnya 2.0", class: "rounded-lg border-gray-300" %>
      <%= f.text_area :definition_json, required: true, rows: 10,
        value: JSON.pretty_generate(@instrument.instrument_type == "other" ? {
          "components" => [
            { "key" => "performance", "label" => "Kinerja yang diamati", "type" => "rating", "minimum" => 1, "maximum" => 5, "levels" => { "1" => { "label" => "Perlu bimbingan penuh", "description" => "Belum menjalankan langkah utama dengan aman." }, "2" => { "label" => "Dengan arahan", "description" => "Melakukan sebagian langkah dengan arahan langsung." }, "3" => { "label" => "Dengan supervisi", "description" => "Melakukan langkah utama dengan supervisi." }, "4" => { "label" => "Mandiri", "description" => "Melakukan kegiatan secara mandiri pada kasus rutin." }, "5" => { "label" => "Membimbing", "description" => "Melakukan dan membimbing orang lain secara aman." } }, "required" => true },
            { "key" => "feedback", "label" => "Umpan balik naratif", "type" => "text", "required" => false }
          ], "change_notes" => ""
        } : { "dimensions" => {}, "scale" => [], "validation_rules" => {}, "change_notes" => "" }),
        class: "rounded-lg border-gray-300 font-mono text-xs" %>
      <%= f.submit "Simpan sebagai draf", class: "w-fit rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </section>
  <section class="space-y-3">
    <h2 class="font-semibold">Riwayat versi</h2>
    <% @versions.each do |version| %>
      <article class="rounded-xl border border-gray-200 bg-white p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div><h3 class="font-medium">Versi <%= version.version_label %> · <%= version.published_at ? "Terbit" : "Draf" %></h3><p class="text-xs text-gray-500"><%= version.published_at ? "Diterbitkan #{l(version.published_at, format: :long)} oleh #{version.published_by&.full_name}" : "Belum diterbitkan" %></p></div>
          <% unless version.published_at %>
            <%= button_to "Terbitkan", publish_admin_wpba_instrument_version_path(@instrument, version), method: :patch,
              class: "rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white" %>
          <% end %>
        </div>
        <pre class="mt-3 overflow-x-auto rounded-lg bg-slate-50 p-3 text-xs"><%= JSON.pretty_generate(version.definition) %></pre>
      </article>
    <% end %>
    <% if @versions.empty? %><p class="text-sm text-gray-500">Belum ada versi definisi.</p><% end %>
  </section>
</div>
