<div class="max-w-5xl mx-auto px-4 py-6 space-y-6">
  <div><h1 class="text-2xl font-bold">Observasi EPA</h1><p class="text-sm text-gray-600">Rekam formatif dan status pengajuan panel untuk <%= @student.full_name %>.</p></div>
  <% if @epas.any? %>
    <section class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4"><h2 class="font-semibold text-indigo-950">Progres EPA dan Otoritas Akademik</h2>
      <p class="mt-1 text-xs text-indigo-900">Kecukupan bukti, observasi formatif, dan keputusan entrustment ditampilkan terpisah. Memenuhi syarat promosi bukan keputusan kewenangan.</p>
      <% @epas.each do |epa| %>
        <% readiness = @readiness[epa] %>
        <% requirement_progress = @requirement_progress[epa] %>
        <% gating_progress = @gating_requirement_progress[epa] %>
        <% promotion = (@promotions_by_epa[epa.id] || []).first %>
        <% decision = @current_decisions[epa.id] %>
        <% observations = @usable_observations_by_epa[epa.id] || [] %>
        <article class="mt-3 rounded-xl border border-indigo-100 bg-white p-3">
          <div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm font-semibold"><%= epa.code %> · <%= epa.title %></p><span class="text-xs text-indigo-800"><%= promotion ? promotion.status.humanize : "Belum diajukan" %></span></div>
          <% sufficient = gating_progress.any? && gating_progress.values.all? { |progress| progress.status == :fulfilled } %>
          <p class="mt-1 text-xs <%= sufficient ? 'text-emerald-700' : 'text-amber-800' %>"><%= sufficient ? "Seluruh Syarat Bukti EPA terpenuhi (wajib/kritis); keputusan tetap melalui panel." : "Kecukupan bukti EPA belum terpenuhi; keputusan tetap melalui panel." %></p>
          <% if requirement_progress.any? %>
            <ul class="mt-1 space-y-1 text-xs text-slate-700"><% requirement_progress.each do |requirement, progress| %><li><%= EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(requirement.source_type, requirement.source_type) %> · <%= progress.record_count %>/<%= requirement.required_count %> · <%= progress.status == :fulfilled ? "terpenuhi" : "belum terpenuhi" %><%= " · wajib/kritis" if gating_progress.key?(requirement) %></li><% end %></ul>
          <% else %><p class="mt-1 text-xs text-amber-800">Belum ada Syarat Bukti EPA aktif; promosi tidak dapat dilakukan.</p><% end %>
          <% unless readiness.eligible %><ul class="mt-1 list-disc pl-5 text-xs text-slate-600"><% readiness.reasons.each do |reason| %><li>Kesiapan promosi: <%= reason %></li><% end %></ul><% end %>
          <% if decision %><p class="mt-2 rounded-lg bg-emerald-50 px-2 py-1 text-xs text-emerald-800">Keputusan entrustment aktif: <%= decision.level_label %>. Ini merupakan keputusan panel, terpisah dari kecukupan bukti.</p><% end %>
          <% if @observable_epa_ids.include?(epa.id) %>
            <%= link_to "Catat observasi EPA", new_epa_observation_path(student_id: @student.id, epa_id: epa.id), class: "mt-2 inline-flex rounded-lg border border-indigo-200 px-3 py-1.5 text-xs font-semibold text-indigo-700" %>
          <% end %>
          <% if observations.any? %>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-600">
              <span><%= observations.size %> observasi</span>
              <span><%= observations.map(&:observer_id).uniq.size %> penilai berbeda</span>
              <span><%= observations.filter_map(&:clinical_case_id).uniq.size %> kasus berbeda</span>
              <span><%= observations.map { |o| o.observed_at.to_date }.uniq.size %> kesempatan/tanggal berbeda</span>
            </div>
            <div class="mt-2 space-y-2">
              <p class="text-[11px] font-semibold text-slate-600">Jejak supervisi longitudinal (dipisah menurut versi skala)</p>
              <% observations.group_by { |observation| observation.supervision_level.supervision_scale_version }
                .sort_by { |scale, _rows| [scale.name, scale.version_label] }.each do |scale, scale_observations| %>
                <div class="rounded-lg bg-slate-50 p-2">
                  <p class="text-[10px] font-semibold text-slate-600"><%= scale.name %> · versi <%= scale.version_label %></p>
                  <p class="mt-1 text-[10px] text-slate-500">Tren supervisi pada versi skala ini (ordinal instrumen, bukan keputusan entrustment)</p>
                  <%= line_chart scale_observations.sort_by(&:observed_at).map { |observation| [observation.observed_at.iso8601, observation.supervision_level.ordinal] },
                    height: "140px", points: true, xtitle: "Waktu observasi", ytitle: "Ordinal skala", min: 1,
                    max: scale.supervision_levels.maximum(:ordinal) %>
                  <ol class="mt-1 flex flex-wrap gap-1.5">
                    <% scale_observations.sort_by(&:observed_at).each do |observation| %>
                      <li class="rounded-full bg-white px-2 py-1 text-[10px] text-slate-700">
                        <%= l(observation.observed_at.to_date, format: :short) %> · <%= observation.supervision_level.label %>
                      </li>
                    <% end %>
                  </ol>
                </div>
              <% end %>
            </div>
          <% else %><p class="mt-2 text-xs text-gray-500">Belum ada observasi formatif untuk EPA ini.</p><% end %>
          <% cycles = @cycle_evidence_summaries.fetch(epa, []) %>
          <% if cycles.any? %>
            <div class="mt-3 overflow-x-auto border-t border-slate-100 pt-3">
              <h3 class="text-xs font-semibold text-slate-700">Perbandingan jejak observasi per siklus akademik</h3>
              <p class="mt-1 text-[10px] text-slate-500">Siklus mengikuti periode pada rotasi klinik. Tabel ini menunjukkan cakupan dan keragaman observasi, bukan kecukupan bukti atau keputusan entrustment.</p>
              <table class="mt-2 min-w-full text-left text-[11px]">
                <thead class="text-slate-500"><tr><th class="px-2 py-1">Periode</th><th class="px-2 py-1">Observasi valid</th><th class="px-2 py-1">Penilai</th><th class="px-2 py-1">Kasus</th><th class="px-2 py-1">Kesempatan</th><th class="px-2 py-1">Flag keselamatan terbuka</th></tr></thead>
                <tbody class="divide-y divide-slate-100"><% cycles.each do |cycle| %>
                  <tr><th class="px-2 py-1 font-medium"><%= cycle.period_label %></th><td class="px-2 py-1"><%= cycle.valid_observations.size %></td><td class="px-2 py-1"><%= cycle.assessor_count %></td><td class="px-2 py-1"><%= cycle.case_count %></td><td class="px-2 py-1"><%= cycle.opportunity_count %></td><td class="px-2 py-1 <%= cycle.unresolved_safety_count.positive? ? 'font-semibold text-rose-700' : 'text-slate-600' %>"><%= cycle.unresolved_safety_count %></td></tr>
                <% end %></tbody>
              </table>
            </div>
          <% end %>
        </article>
      <% end %>
    </section>
  <% end %>
  <section class="space-y-3">
    <% @observations.each do |observation| %>
      <article class="rounded-xl border border-gray-200 bg-white p-4">
        <div class="flex flex-wrap justify-between gap-2"><strong><%= observation.epa.code %> · <%= observation.epa.title %></strong><span class="text-xs text-gray-500"><%= l(observation.observed_at, format: :long) %> · <%= observation.complexity.humanize %></span></div>
        <p class="mt-2 text-sm"><%= observation.narrative %></p><p class="mt-2 text-xs text-gray-500">Pengamat: <%= observation.observer.full_name %> · Supervisi: <%= observation.supervision_level.label %> · <%= observation.supervision_level.supervision_scale_version.name %> versi <%= observation.supervision_level.supervision_scale_version.version_label %></p>
        <% if observation.strengths.present? || observation.areas_to_improve.present? %><div class="mt-2 grid gap-2 text-xs sm:grid-cols-2"><% if observation.strengths.present? %><p><span class="font-semibold">Kekuatan:</span> <%= observation.strengths %></p><% end %><% if observation.areas_to_improve.present? %><p><span class="font-semibold">Perlu dikembangkan:</span> <%= observation.areas_to_improve %></p><% end %></div><% end %>
        <% if observation.safety_flag? %>
          <% if observation.safety_resolved_at.present? %>
            <p class="mt-2 text-xs font-semibold text-emerald-700">Tindak lanjut keselamatan dicatat oleh <%= observation.safety_resolved_by.full_name %>: <%= observation.safety_resolution %></p>
          <% else %>
            <p class="mt-2 text-xs font-semibold text-rose-700">Perlu tindak lanjut keselamatan; belum dapat dihitung untuk promosi.</p>
            <% if AssignmentAuthorization.assigned?(user: current_user, role: "epa_panel_member", student: observation.student) %>
              <%= form_with url: resolve_safety_epa_observation_path(observation), method: :patch, class: "mt-2 flex flex-col gap-2 sm:flex-row" do |f| %>
                <%= f.text_field :safety_resolution, required: true, minlength: 10, placeholder: "Catatan tindak lanjut keselamatan", class: "min-w-0 flex-1 rounded-lg border-gray-300 text-sm" %>
                <%= f.submit "Catat tindak lanjut", class: "rounded-lg bg-emerald-700 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </article>
    <% end %>
    <% if @observations.empty? %><p class="rounded-xl bg-white p-5 text-sm text-gray-500">Belum ada observasi EPA.</p><% end %>
  </section>
</div>
