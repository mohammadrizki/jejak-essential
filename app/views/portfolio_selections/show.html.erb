<div class="mx-auto max-w-4xl space-y-4 px-4 py-6">
  <header>
    <h1 class="text-2xl font-bold">Portofolio Terpilih · <%= @student.full_name %></h1>
    <p class="mt-1 text-sm text-gray-600">Hanya artefak yang dipilih untuk penelaah berwenang. Data sumber tetap berada di modul asal.</p>
  </header>
  <% @selections.each do |selection| %>
    <article class="rounded-2xl border border-gray-200 bg-white p-5">
      <h2 class="font-semibold"><%= selection.artifact_submission.source_title %></h2>
      <p class="mt-2 text-sm"><%= selection.artifact_submission.selection_reason %></p>
      <% if selection.artifact_submission.reflection.present? %>
        <p class="mt-2 whitespace-pre-line text-sm text-gray-700"><%= selection.artifact_submission.reflection %></p>
      <% end %>
      <p class="mt-3 text-xs text-gray-500">Ditelaah oleh <%= selection.artifact_submission.reviewer&.full_name %></p>
    </article>
  <% end %>
  <% if @selections.empty? %><p class="rounded-xl bg-white p-5 text-sm text-gray-500">Belum ada artefak yang dibagikan ke penelaah.</p><% end %>
</div>
