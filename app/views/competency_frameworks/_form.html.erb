<%= form_with model: competency_framework, class: "space-y-4" do |f| %>
  <% if competency_framework.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= competency_framework.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :study_program_id, "Program Studi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.collection_select :study_program_id, @study_programs, :id, :name, { prompt: "Pilih program studi" }, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-sm ring-1 ring-inset ring-gray-300" %>
  </div>

  <div>
    <%= f.label :name, "Nama Peta Kompetensi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, placeholder: "Contoh: Standar Kompetensi Dokter Indonesia",
          class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <%= f.label :version, "Versi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :version, placeholder: "otomatis", class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-sm ring-1 ring-inset ring-gray-300" %>
    </div>
    <div>
      <%= f.label :education_stage, "Jenjang", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :education_stage, [["Sarjana", "undergraduate"], ["Profesi", "professional"], ["Spesialis", "specialist"], ["Subspesialis", "subspecialist"]], { include_blank: "Ikuti program studi" }, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-sm ring-1 ring-inset ring-gray-300" %>
    </div>
    <div>
      <%= f.label :status, "Status versi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :status, [["Draf", "draft"], ["Terbit", "published"], ["Arsip", "archived"]], {}, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-sm ring-1 ring-inset ring-gray-300" %>
    </div>
  </div>

  <div>
    <%= f.label :description, "Deskripsi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 2,
          class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
  </div>

  <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
<% end %>
