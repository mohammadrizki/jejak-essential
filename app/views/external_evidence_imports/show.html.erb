<div class="mx-auto max-w-4xl space-y-5 px-4 py-6 sm:px-6">
  <%= link_to "← Riwayat impor", external_evidence_imports_path, class: "text-sm text-indigo-700" %>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h1 class="text-2xl font-bold text-slate-900">Riwayat Impor Bukti</h1><dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">Program Studi</dt><dd><%= @batch.study_program.name %></dd></div><div><dt class="text-slate-500">Sumber</dt><dd><%= @batch.source_system.humanize %></dd></div><div><dt class="text-slate-500">Berkas</dt><dd><%= @batch.filename %></dd></div><div><dt class="text-slate-500">Diunggah oleh</dt><dd><%= @batch.uploaded_by.full_name %></dd></div><div><dt class="text-slate-500">Status</dt><dd><%= @batch.status.humanize %></dd></div><div><dt class="text-slate-500">Diproses</dt><dd><%= @batch.imported_count %> dari <%= @batch.row_count %> baris</dd></div></dl></section>
  <section class="space-y-2"><h2 class="font-semibold">Hasil per baris</h2><% @batch.row_results.each do |row| %><article class="rounded-lg border border-slate-200 bg-white p-3 text-sm"><strong>Baris <%= row["row"] || "—" %> · <%= row["source_record_id"] || "tanpa ID" %> · <%= row["status"] %></strong><% if row["errors"].present? %><p class="mt-1 text-rose-700"><%= row["errors"].join("; ") %></p><% end %><% if row["evidence_source_id"].present? %><p class="mt-1 text-xs text-slate-500">EvidenceSource JEJAK #<%= row["evidence_source_id"] %></p><% end %></article><% end %></section>
</div>
