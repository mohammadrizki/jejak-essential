<div class="mx-auto max-w-5xl space-y-5 px-4 py-6 sm:px-6">
  <div><%= link_to "← Riwayat impor", external_evidence_imports_path, class: "text-sm text-indigo-700" %><h1 class="mt-3 text-2xl font-bold text-slate-900">Pratinjau Bukti Eksternal</h1><p class="mt-1 text-sm text-slate-600"><%= @study_program.name %> · <%= @source_system.humanize %> · <%= @batch.filename %> · <%= @preview.rows.length %> baris</p></div>
  <% if @preview.valid? %>
    <div class="rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800">Semua baris lolos validasi awal. Bukti tetap berstatus belum tervalidasi setelah impor.</div>
    <%= form_with url: external_evidence_imports_path, method: :post, multipart: true, class: "rounded-xl border border-slate-200 bg-white p-5" do %>
      <%= hidden_field_tag :stage, "import" %><%= hidden_field_tag :study_program_id, @study_program.id %><%= hidden_field_tag :source_system, @source_system %><%= hidden_field_tag :batch_id, @batch.id %><%= hidden_field_tag :file_sha256, @preview.sha256 %>
      <label class="mb-1 block text-sm font-medium" for="csv_file">Pilih ulang berkas yang sama untuk mengonfirmasi impor</label><%= file_field_tag :csv_file, accept: ".csv,text/csv", required: true, class: "w-full rounded-lg border border-slate-300 p-2 text-sm" %>
      <%= submit_tag "Konfirmasi impor #{@preview.rows.length} baris", class: "mt-4 rounded-lg bg-indigo-700 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  <% else %>
    <div role="alert" class="rounded-lg bg-rose-50 p-3 text-sm text-rose-800">Ada baris yang belum valid. Tidak ada bukti yang akan diimpor; perbaiki berkas lalu mulai pratinjau baru.</div>
  <% end %>
  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Baris</th><th class="px-4 py-3">Record Sumber</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Validasi / Kesalahan</th></tr></thead><tbody class="divide-y divide-slate-100"><% @preview.rows.each do |row| %><tr><td class="px-4 py-3"><%= row.number %></td><td class="px-4 py-3"><%= row.source_record_id.presence || "—" %></td><td class="px-4 py-3"><%= row.errors.empty? ? "Siap" : "Perlu perbaikan" %></td><td class="px-4 py-3"><%= row.errors.presence&.join("; ") || "Mahasiswa dan Syarat Bukti cocok." %></td></tr><% end %></tbody></table></div>
</div>
