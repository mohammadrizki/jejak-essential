<div class="mx-auto max-w-3xl space-y-5 px-4 py-6 sm:px-6">
  <div><%= link_to "← Riwayat impor", external_evidence_imports_path, class: "text-sm text-indigo-700" %><h1 class="mt-3 text-2xl font-bold text-slate-900">Impor Bukti Eksternal</h1><p class="mt-1 text-sm text-slate-600">Unggah CSV atau XLSX, periksa kecocokan mahasiswa dan Bukti yang Diharapkan, lalu konfirmasi dengan berkas yang sama. Data masuk sebagai belum tervalidasi.</p></div>
  <% if @error.present? %><div role="alert" class="rounded-lg bg-rose-50 p-3 text-sm text-rose-800"><%= @error %></div><% end %>
  <section class="rounded-xl border border-slate-200 bg-white p-5">
    <%= form_with url: external_evidence_imports_path, method: :post, multipart: true, class: "space-y-4" do |f| %>
      <%= hidden_field_tag :stage, "preview" %>
      <% unless current_user.study_program_bound? %><div><%= label_tag :study_program_id, "Program Studi", class: "mb-1 block text-sm font-medium" %><%= select_tag :study_program_id, options_from_collection_for_select(@programs, :id, :name, @study_program&.id), include_blank: "Pilih program studi", required: true, class: "w-full rounded-lg border-slate-300" %></div><% else %><%= hidden_field_tag :study_program_id, @study_program.id %><p class="text-sm"><strong>Program Studi:</strong> <%= @study_program.name %></p><% end %>
      <div><%= label_tag :source_system, "Sistem Sumber", class: "mb-1 block text-sm font-medium" %><%= select_tag :source_system, options_for_select(@enabled_sources.map { |source| [source.humanize, source] }, @source_system), include_blank: "Pilih sumber yang aktif", required: true, disabled: @enabled_sources.empty?, class: "w-full rounded-lg border-slate-300" %>
        <% if @enabled_sources.empty? %><p class="mt-1 text-xs text-slate-500">Belum ada adapter aktif untuk program studi ini. Aktifkan adapter pada Pengaturan Modul untuk mengimpor bukti.</p><% end %>
      </div>
      <div><%= label_tag :csv_file, "Berkas CSV atau XLSX (sheet pertama, maksimum 10 MB dan 2.000 baris)", class: "mb-1 block text-sm font-medium" %><%= file_field_tag :csv_file, accept: ".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", required: true, disabled: @enabled_sources.empty?, class: "w-full rounded-lg border border-slate-300 p-2 text-sm" %></div>
      <div class="flex flex-wrap items-center justify-between gap-3"><%= f.submit "Pratinjau dan validasi", disabled: @enabled_sources.empty?, class: "rounded-lg bg-indigo-700 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50" %><%= link_to "Unduh templat CSV", template_external_evidence_imports_path(format: :csv), class: "text-sm font-medium text-indigo-700 hover:underline" %></div>
    <% end %>
  </section>
  <aside class="rounded-xl bg-slate-50 p-4 text-xs leading-5 text-slate-600">Pemetaan identifier mahasiswa harus tersedia lebih dahulu. Bukti yang Diharapkan harus aktif, bertipe Eksternal, dan milik Program Studi yang dipilih. Impor tidak membuat keputusan capaian kompetensi dan tidak menandai bukti sebagai valid.</aside>
</div>
