<%# Navigasi JEJAK mengikuti peran aktif dan cakupan kewenangan. %>
<%
  is_student = local_assigns[:is_student] || false
  is_dosen = local_assigns[:is_dosen] || false
  is_preceptor = local_assigns[:is_preceptor] || false
  is_kaprodi = local_assigns[:is_kaprodi] || false
  is_admin = local_assigns[:is_admin] || false
  is_tendik = local_assigns[:is_tendik] || false
  is_verifier = local_assigns[:is_verifier] || false
  is_config_manager = local_assigns[:is_config_manager] || false
  can_manage_curriculum = is_kaprodi || (is_admin && (current_user.has_role?("superadmin") ||
    StudyProgram.ordered.any? { |program| current_user.has_permission?("curriculum.manage", study_program: program) }))
  is_prodi_manager = local_assigns[:is_prodi_manager] || false
  is_srq_monitor = local_assigns[:is_srq_monitor] || false
  is_srq_student = local_assigns[:is_srq_student] || false
  has_evidence_requirements = local_assigns[:has_evidence_requirements] || false
  logbook_visible = local_assigns[:logbook_visible] || false
  wpba_visible = local_assigns[:wpba_visible] || false
  assigned_logbook_verifier = local_assigns[:assigned_logbook_verifier] || false
  assigned_evidence_reviewer = local_assigns[:assigned_evidence_reviewer] || false
  assigned_external_data_manager = local_assigns[:assigned_external_data_manager] || false
  can_review_artifacts = local_assigns[:can_review_artifacts] || false
  epa_relevant = local_assigns[:epa_relevant] || false
  epa_staff_visible = local_assigns[:epa_staff_visible] || false
  pending_verifications = local_assigns[:pending_verifications] || 0
  pending_activity_verifications = local_assigns[:pending_activity_verifications] || 0
  active_class = ->(paths) { Array(paths).any? { |path| request.path == path || request.path.start_with?(path) } }
  has_epa_panel_assignment = UserAssignment.active.exists?(user: current_user, assignment_role: %w[epa_panel_member epa_panel_chair])
  can_review_promotions = epa_staff_visible && (is_kaprodi || is_preceptor || has_epa_panel_assignment)
  has_assessment_events = is_student && AssessmentEvent.published.any? { |event| event.visible_to?(current_user) }
  has_student_assessment_results = is_student && current_user.assessment_instances.exists?
  has_user_directory = is_dosen || is_preceptor || is_kaprodi || is_admin
  has_external_data_access = is_config_manager || is_prodi_manager || (is_tendik && assigned_external_data_manager)
  can_review_cases = is_verifier
  verification_scope = params[:scope].in?(%w[to_verify reviewed])
  student_home = request.path == "/dashboard" || request.path == "/"
  portfolio_active = active_class.call("/portfolio")
  epa_active = active_class.call(%w[/dashboard/entrustment /epa_observations /epa_promotions])
%>

<div>
  <p class="px-2 mb-1 text-[10px] font-bold uppercase tracking-widest text-slate-500">DASHBOARD</p>
  <%= render "shared/nav_item", label: (is_student ? "Dashboard Saya" : is_admin ? "Dashboard Sistem" : is_kaprodi ? "Dashboard Program Studi" : is_preceptor ? "Dashboard Supervisi" : is_dosen ? "Dashboard Penugasan" : is_tendik ? "Dashboard Operasional" : "Dashboard"), path: dashboard_path,
      active: student_home %>
</div>

<% if is_student %>
  <%= render "shared/nav_accordion", label: "Target Kompetensi", open: active_class.call(%w[/competency_frameworks /competency_items /peta-artefak]) || (portfolio_active && params[:section] == "evidence-requirements") do %>
    <%= render "shared/nav_item", label: "Peta Kompetensi Saya", path: competency_frameworks_path,
        active: active_class.call(%w[/competency_frameworks /competency_items]) %>
    <%= render "shared/nav_item", label: "Peta Artefak Saya", path: artifact_map_path,
        active: active_class.call("/peta-artefak") %>
    <% if has_evidence_requirements %>
      <%= render "shared/nav_item", label: "Syarat Bukti", path: portfolio_path(section: "evidence-requirements", anchor: "evidence-requirements"),
          active: portfolio_active && params[:section] == "evidence-requirements" %>
    <% end %>
  <% end %>

  <%= render "shared/nav_accordion", label: "Portofolio Saya", open: portfolio_active || active_class.call(%w[/reflection_entries /portofolio-terpilih /student/feedback_journal]) do %>
    <%= render "shared/nav_item", label: "Koleksi Bukti", path: portfolio_path,
        active: portfolio_active && params[:section] != "evidence-requirements" %>
    <%= render "shared/nav_item", label: "Refleksi Pengalaman Belajar", path: reflection_entries_path,
        active: active_class.call("/reflection_entries") %>
    <%= render "shared/nav_item", label: "Pengajuan Artefak", path: portfolio_path(anchor: "artifact-submissions"),
        active: portfolio_active && params[:anchor] == "artifact-submissions" %>
    <%= render "shared/nav_item", label: "Portofolio Terpilih", path: portfolio_path(anchor: "selected-portfolio"),
        active: portfolio_active && params[:anchor] == "selected-portfolio" %>
    <%= render "shared/nav_item", label: "Umpan Balik", path: student_feedback_journal_path,
        active: active_class.call("/student/feedback_journal") %>
  <% end %>

  <% if logbook_visible %>
    <%= render "shared/nav_accordion", label: "Logbook Klinis", open: active_class.call(%w[/activity_logs /kalender /clinical_cases]) do %>
      <%= render "shared/nav_item", label: "Aktivitas Logbook", path: activity_logs_path,
          active: active_class.call(%w[/activity_logs /kalender]) %>
      <%= render "shared/nav_item", label: "Kasus Klinis", path: clinical_cases_path,
          active: active_class.call("/clinical_cases") %>
    <% end %>
  <% end %>

  <% if wpba_visible %>
    <%= render "shared/nav_accordion", label: "Workplace-Based Assessment", open: active_class.call(%w[/asesmen /student/assessments /dops_evaluations /mini_cex_evaluations /wpba_observations]) do %>
      <%= render "shared/nav_item", label: "Hasil dan Umpan Balik WPBA", path: (has_assessment_events ? student_assessments_path : assessments_path),
          active: active_class.call(%w[/asesmen /student/assessments /dops_evaluations /mini_cex_evaluations /wpba_observations]) %>
    <% end %>
  <% end %>

  <% if epa_relevant %>
    <%= render "shared/nav_accordion", label: "EPA", open: epa_active do %>
      <%= render "shared/nav_item", label: "Progres & Observasi EPA", path: epa_observations_path,
          active: active_class.call("/epa_observations") %>
      <%= render "shared/nav_item", label: "Keputusan Entrustment", path: entrustment_decisions_path,
          active: active_class.call("/dashboard/entrustment") %>
    <% end %>
  <% end %>

  <%= render "shared/nav_accordion", label: "Capaian Saya", open: active_class.call("/capaian-belajar") || (portfolio_active && params[:section] == "evidence-requirements") do %>
    <% if has_evidence_requirements %>
      <%= render "shared/nav_item", label: "Kecukupan Bukti", path: portfolio_path(section: "evidence-requirements", anchor: "evidence-requirements"),
          active: portfolio_active && params[:section] == "evidence-requirements" %>
    <% end %>
    <%= render "shared/nav_item", label: "Capaian Kompetensi", path: academic_assessments_path,
        active: active_class.call("/capaian-belajar") %>
  <% end %>
<% end %>

<% if is_dosen || is_preceptor %>
  <%= render "shared/nav_accordion", label: (is_preceptor ? "Mahasiswa Supervisi" : "Mahasiswa Bimbingan"), open: active_class.call("/cari") do %>
    <%= render "shared/nav_item", label: "Daftar Mahasiswa", path: search_path,
        active: active_class.call("/cari") %>
  <% end %>
  <% if logbook_visible && (assigned_logbook_verifier || can_review_cases) %>
    <%= render "shared/nav_accordion", label: "Logbook Klinis", open: active_class.call(%w[/activity_logs /clinical_cases]) && verification_scope do %>
      <% if can_review_cases %>
        <%= render "shared/nav_item", label: "Validasi Kasus", path: clinical_cases_path(scope: "to_verify"),
            active: active_class.call("/clinical_cases") && verification_scope,
            badge: (pending_verifications.positive? ? (pending_verifications > 9 ? "9+" : pending_verifications) : nil) %>
      <% end %>
      <% if assigned_logbook_verifier %>
        <%= render "shared/nav_item", label: "Validasi Aktivitas", path: activity_logs_path(scope: "to_verify"),
            active: active_class.call("/activity_logs") && params[:scope] == "to_verify",
            badge: (pending_activity_verifications.positive? ? (pending_activity_verifications > 9 ? "9+" : pending_activity_verifications) : nil) %>
      <% end %>
    <% end %>
  <% end %>
  <% if wpba_visible %>
    <%= render "shared/nav_accordion", label: "Workplace-Based Assessment", open: active_class.call(%w[/asesmen /examiner_evaluations /dops_evaluations /mini_cex_evaluations /wpba_observations]) do %>
      <%= render "shared/nav_item", label: "Penilaian WPBA", path: examiner_evaluations_path,
          active: active_class.call("/examiner_evaluations") %>
      <%= render "shared/nav_item", label: "Observasi WPBA", path: assessments_path,
          active: active_class.call(%w[/asesmen /dops_evaluations /mini_cex_evaluations /wpba_observations]) %>
    <% end %>
  <% end %>
  <% if is_dosen %>
    <%= render "shared/nav_item", label: "Monitoring Kompetensi", path: analytics_path,
        active: active_class.call("/analitik") %>
  <% end %>
  <% if can_review_promotions %>
    <%= render "shared/nav_accordion", label: "EPA", open: epa_active do %>
      <%= render "shared/nav_item", label: "Promosi dan Tinjauan EPA", path: epa_promotions_path,
          active: active_class.call(%w[/epa_promotions /epa_observations]) %>
      <%= render "shared/nav_item", label: "Observasi EPA", path: epa_observations_path,
          active: active_class.call("/epa_observations") %>
    <% end %>
  <% end %>
  <% if is_verifier %>
    <%= render "shared/nav_accordion", label: "Penilaian dan Validasi", open: active_class.call(%w[/evidence_sources /artifact_submissions /clinical_cases /activity_logs]) do %>
      <%= render "shared/nav_item", label: "Telaah Artefak", path: artifact_submissions_path,
          active: active_class.call("/artifact_submissions") if can_review_artifacts %>
        <%= render "shared/nav_item", label: "Penilaian & Validasi Bukti", path: evidence_sources_path,
          active: active_class.call("/evidence_sources") if assigned_evidence_reviewer %>
    <% end %>
  <% end %>
<% end %>

<% if can_manage_curriculum %>
  <%= render "shared/nav_accordion", label: "Pengelolaan Program Studi", open: active_class.call(%w[/competency_framework_templates /competency_frameworks /assessment_blueprints /evidence_requirements /peta-artefak /module_configuration]) do %>
    <%= render "shared/nav_item", label: "Pustaka Kerangka Kompetensi", path: competency_framework_templates_path, active: active_class.call("/competency_framework_templates") %>
    <%= render "shared/nav_item", label: "Peta Kompetensi", path: competency_frameworks_path, active: active_class.call(%w[/competency_frameworks /competency_items]) %>
    <%= render "shared/nav_item", label: "Blueprint Asesmen", path: assessment_blueprints_path, active: active_class.call("/assessment_blueprints") %>
    <%= render "shared/nav_item", label: "Syarat Bukti", path: evidence_requirements_path, active: active_class.call("/evidence_requirements") %>
    <%= render "shared/nav_item", label: "Peta Artefak", path: artifact_map_path, active: active_class.call("/peta-artefak") %>
    <% if is_form_manager %><%= render "shared/nav_item", label: "Instrumen Asesmen Internal", path: assessment_form_templates_path, active: active_class.call(%w[/assessment_form_templates /assessment_form_submissions]) %><% end %>
  <% end %>
  <%= render "shared/nav_accordion", label: "Monitoring dan Peningkatan Mutu", open: active_class.call(%w[/analitik /capaian-belajar /epa_promotions]) do %>
    <%= render "shared/nav_item", label: "Dashboard Capaian", path: analytics_path, active: active_class.call("/analitik") %>
    <%= render "shared/nav_item", label: "Capaian Kompetensi", path: academic_assessments_path, active: active_class.call("/capaian-belajar") %>
    <% if epa_staff_visible %><%= render "shared/nav_item", label: "Tinjauan EPA", path: epa_promotions_path, active: active_class.call("/epa_promotions") %><% end %>
    <%= render "shared/nav_item", label: "Ekspor Data (CSV)", path: admin_exports_path, active: active_class.call("/admin/exports") %>
  <% end %>
  <%= render "shared/nav_accordion", label: "Pengguna dan Penugasan", open: active_class.call(%w[/cari /user_assignments]) do %>
    <%= render "shared/nav_item", label: "Mahasiswa dalam Lingkup Saya", path: search_path, active: active_class.call("/cari") %>
    <%= render "shared/nav_item", label: "Penugasan dan Reviewer", path: user_assignments_path, active: active_class.call("/user_assignments") %>
    <%= render "shared/nav_item", label: "Relabel Prodi Mahasiswa", path: new_admin_student_relabel_path, active: active_class.call("/admin/student_relabel") %>
  <% end %>
  <%= render "shared/nav_item", label: "Aktivasi Modul", path: edit_module_configuration_path(study_program_id: current_user.study_program_id), active: active_class.call("/module_configuration") %>
<% end %>

<% if current_user.has_system_permission?("templates.manage") && !can_manage_curriculum %>
  <%= render "shared/nav_item", label: "Pustaka Kerangka Kompetensi", path: competency_framework_templates_path, active: active_class.call("/competency_framework_templates") %>
<% end %>

<% if is_admin %>
  <p class="px-2 mb-2 text-[10px] font-bold uppercase tracking-widest text-slate-500">ADMINISTRASI</p>
  <% if current_user.has_role?("superadmin") %>
  <%= render "shared/nav_accordion", label: "Program Studi & Kurikulum", open: active_class.call(%w[/study_programs /academic_periods /clinical_rotations /tutorial_enrollments]) do %>
    <%= render "shared/nav_item", label: "Program Studi", path: study_programs_path, active: active_class.call("/study_programs") %>
    <%= render "shared/nav_item", label: "Periode Akademik", path: academic_periods_path, active: active_class.call("/academic_periods") %>
    <%= render "shared/nav_item", label: term("nav.clinical_rotations"), path: clinical_rotations_path, active: active_class.call("/clinical_rotations") %>
  <% end %>
  <%= render "shared/nav_accordion", label: "Pengguna & Hak Akses", open: active_class.call(%w[/admin/users /admin/student_relabel /external_identity_mappings /external_evidence_imports]) do %>
    <%= render "shared/nav_item", label: "Pengguna & Peran", path: admin_users_path, active: active_class.call("/admin/users") %>
    <% if current_user.has_role?("superadmin") %><%= render "shared/nav_item", label: "Kelola Peran & Hak Akses", path: roles_path, active: active_class.call("/roles") %><% end %>
    <%= render "shared/nav_item", label: "Relabel Prodi Mahasiswa", path: new_admin_student_relabel_path, active: active_class.call("/admin/student_relabel") %>
    <% if has_external_data_access %>
      <%= render "shared/nav_item", label: "Pemetaan Identifier Eksternal", path: external_identity_mappings_path, active: active_class.call("/external_identity_mappings") %>
      <%= render "shared/nav_item", label: "Impor Bukti Eksternal", path: external_evidence_imports_path, active: active_class.call("/external_evidence_imports") %>
    <% end %>
  <% end %>
  <%= render "shared/nav_accordion", label: "Master Data", open: active_class.call(%w[/admin/assessment_events /admin/wpba_instruments /assessment_form_templates /admin/glide_syncs /admin/logbook_case_targets /admin/academic_activity_domains /admin/diagnosis_definitions /admin/skill_definitions /admin/medication_definitions /admin/exports]) do %>
    <%= render "shared/nav_item", label: "Instrumen Asesmen Internal", path: assessment_form_templates_path, active: active_class.call(%w[/assessment_form_templates /assessment_form_submissions]) %>
    <%= render "shared/nav_item", label: "Event Asesmen", path: admin_assessment_events_path, active: active_class.call("/admin/assessment_events") %>
    <%= render "shared/nav_item", label: "Katalog Instrumen WPBA", path: admin_wpba_instruments_path, active: active_class.call("/admin/wpba_instruments") %>
    <%= render "shared/nav_item", label: "Target Kasus Logbook", path: admin_logbook_case_targets_path, active: active_class.call("/admin/logbook_case_targets") %>
    <%= render "shared/nav_item", label: "Domain Kegiatan Akademik", path: admin_academic_activity_domains_path, active: active_class.call("/admin/academic_activity_domains") %>
    <%= render "shared/nav_item", label: "Diagnosis", path: admin_diagnosis_definitions_path, active: active_class.call("/admin/diagnosis_definitions") %>
    <%= render "shared/nav_item", label: "Keterampilan", path: admin_skill_definitions_path, active: active_class.call("/admin/skill_definitions") %>
    <%= render "shared/nav_item", label: "Obat", path: admin_medication_definitions_path, active: active_class.call("/admin/medication_definitions") %>
    <%= render "shared/nav_item", label: "Ekspor Data (CSV)", path: admin_exports_path, active: active_class.call("/admin/exports") %>
  <% end %>
  <%= render "shared/nav_accordion", label: "Pengaturan Sistem", open: active_class.call(%w[/module_configuration /admin/terminology /admin/data_governance]) do %>
    <% module_program = StudyProgram.ordered.find { |program| current_user.has_role?("superadmin") || current_user.has_permission?("modules.manage", study_program: program) } %>
    <% if module_program %><%= render "shared/nav_item", label: "Aktivasi Modul", path: edit_module_configuration_path(study_program_id: module_program.id), active: active_class.call("/module_configuration") %><% end %>
    <%= render "shared/nav_item", label: "Taksonomi Istilah", path: admin_terminology_path, active: active_class.call("/admin/terminology") %>
    <%= render "shared/nav_item", label: "Tata Kelola Data", path: admin_data_governance_path, active: active_class.call("/admin/data_governance") %>
  <% end %>
  <% else %>
    <% if current_user.has_permission?("users.manage") || current_user.has_permission?("assignments.manage") %>
      <%= render "shared/nav_accordion", label: "Pengguna & Hak Akses", open: active_class.call("/admin/users") do %>
        <% if current_user.has_permission?("users.manage") %><%= render "shared/nav_item", label: "Pengguna", path: admin_users_path, active: active_class.call("/admin/users") %><% end %>
      <% end %>
    <% end %>
    <% module_program = StudyProgram.ordered.find { |program| current_user.has_permission?("modules.manage", study_program: program) } %>
    <% if module_program %><%= render "shared/nav_accordion", label: "Pengaturan Program", open: active_class.call("/module_configuration") do %>
      <%= render "shared/nav_item", label: "Aktivasi Modul", path: edit_module_configuration_path(study_program_id: module_program.id), active: active_class.call("/module_configuration") %>
    <% end %><% end %>
  <% end %>
  <% if logbook_visible %>
    <%= render "shared/nav_accordion", label: "Logbook Klinis", open: active_class.call(%w[/activity_logs /clinical_cases]) do %>
      <%= render "shared/nav_item", label: term("nav.activity_logs"), path: activity_logs_path, active: active_class.call("/activity_logs") %>
    <% end %>
  <% end %>
<% end %>

<% if is_tendik && assigned_external_data_manager %>
  <p class="px-2 mb-2 text-[10px] font-bold uppercase tracking-widest text-slate-500">ADMINISTRASI</p>
  <%= render "shared/nav_accordion", label: "Pengguna & Hak Akses", open: active_class.call(%w[/external_identity_mappings /external_evidence_imports]) do %>
    <%= render "shared/nav_item", label: "Pemetaan Identifier Eksternal", path: external_identity_mappings_path, active: active_class.call("/external_identity_mappings") %>
    <%= render "shared/nav_item", label: "Impor Bukti Eksternal", path: external_evidence_imports_path, active: active_class.call("/external_evidence_imports") %>
  <% end %>
<% end %>

<% if assigned_evidence_reviewer && !(is_dosen || is_preceptor) %>
  <%= render "shared/nav_item", label: "Penilaian & Validasi Bukti", path: evidence_sources_path, active: active_class.call("/evidence_sources") %>
<% end %>

<% if is_srq_student || is_srq_monitor %>
  <div>
    <p class="px-2 mb-1 text-[10px] font-bold uppercase tracking-widest text-slate-500">LAYANAN MAHASISWA</p>
    <% if is_srq_student %><%= render "shared/nav_item", label: "Skrining Kesehatan (SRQ-20)", path: srq_screenings_path, active: active_class.call("/kesehatan-mental") %><% end %>
    <% if is_srq_monitor %><%= render "shared/nav_item", label: "Tindak Lanjut SRQ", path: srq_monitoring_path, active: active_class.call("/monitoring-srq") %><% end %>
  </div>
<% end %>
