<div class="max-w-xl">
  <h1 class="text-xl font-bold text-gray-900 mb-2">Sunting syarat bukti</h1>
  <p class="text-sm text-gray-500 mb-6"><%= @requirement.competency_indicator&.description || @requirement.competency_item&.title || @requirement.epa&.title || @blueprint_item&.title %></p>

  <%= form_with model: @requirement, url: @blueprint_item ? blueprint_item_evidence_requirement_path(@blueprint_item, @requirement) : competency_framework_evidence_requirement_path(@framework, @requirement), method: :patch, class: "space-y-4" do |f| %>
    <% if @requirement.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm"><%= @requirement.errors.full_messages.to_sentence %></div>
    <% end %>
    <div>
      <%= f.label :source_type, "Jenis bukti", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :source_type, EvidenceRequirement::SOURCE_TYPES.map { |value| [EvidenceRequirement::SOURCE_TYPE_LABELS.fetch(value), value] }, {}, class: "block w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <div>
      <%= f.label :required_count, "Jumlah bukti", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.number_field :required_count, min: 1, required: true, class: "block w-full rounded-lg border-gray-300 text-sm" %>
    </div>
    <%= render "fulfillment_fields", rule: @requirement.fulfillment_rule || {}, indicator: @requirement.competency_indicator %>
    <div class="flex items-center gap-3">
      <%= f.submit "Simpan perubahan", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white cursor-pointer" %>
      <%= link_to "Batal", @blueprint_item ? assessment_blueprint_path(@assessment_blueprint) : competency_framework_path(@framework), class: "text-sm text-gray-500" %>
    </div>
  <% end %>
</div>
