<div class="inline-flex shrink-0 items-center gap-1">
  <%= link_to edit_path, title: "Sunting syarat bukti", aria: { label: "Sunting syarat bukti" },
        class: "inline-flex h-7 w-7 items-center justify-center rounded-md text-indigo-600 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 2.651 2.651M8 16l8.5-8.5a1.875 1.875 0 0 1 2.652 2.652L10.652 18.65a4.5 4.5 0 0 1-1.897 1.13L5.25 20.75l.97-3.505A4.5 4.5 0 0 1 7.35 15.35" />
    </svg>
    <span class="sr-only">Sunting</span>
  <% end %>
  <%= button_to path, method: :delete, title: "Hapus syarat bukti", aria: { label: "Hapus syarat bukti" },
        class: "inline-flex h-7 w-7 items-center justify-center rounded-md text-rose-600 hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500",
        form: { class: "inline-flex", data: { turbo_confirm: "Hapus syarat bukti ini?" } } do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12m-10 0 .7 12h6.6L16 7M9.5 7V4.75h5V7m-4 3v5m3-5v5" />
    </svg>
    <span class="sr-only">Hapus</span>
  <% end %>
</div>
