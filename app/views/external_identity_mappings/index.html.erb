<div class="mx-auto max-w-6xl space-y-5 px-4 py-6">
  <header>
    <h1 class="text-2xl font-bold">Pemetaan Identifier Eksternal</h1>
    <p class="mt-1 text-sm text-gray-600">Nama bukan kunci pencocokan. Pemetaan menghubungkan identifier sumber ke ID mahasiswa internal JEJAK dan tidak membuat akun baru.</p>
  </header>
  <section class="rounded-2xl border border-gray-200 bg-white p-5">
    <h2 class="font-semibold">Tambahkan pemetaan</h2>
    <%= form_with scope: :external_identity_mapping, url: external_identity_mappings_path,
      class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
      <%= f.select :source_system, [["SIA", "sia"], ["Moodle", "moodle"], ["Examtool", "examtool"], ["Aplikasi OSCE", "osce"]],
        {}, class: "rounded-lg border-gray-300" %>
      <%= f.text_field :external_id, required: true, placeholder: "ID mahasiswa pada sistem sumber", class: "rounded-lg border-gray-300" %>
      <%= f.collection_select :student_id, @students, :id, :full_name, { prompt: "Cocokkan ke mahasiswa JEJAK" }, required: true, class: "rounded-lg border-gray-300" %>
      <%= f.text_field :source_revision, placeholder: "Versi / periode sumber (opsional)", class: "rounded-lg border-gray-300" %>
      <%= f.submit "Simpan pemetaan", class: "w-fit rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </section>
  <section class="space-y-3">
    <% @mappings.each do |mapping| %>
      <article class="rounded-2xl border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap justify-between gap-2">
          <div><h2 class="font-semibold"><%= mapping.source_system.upcase %> · <%= mapping.external_id %></h2>
            <p class="text-sm text-gray-600">Dipetakan ke <%= mapping.internal_record&.full_name || "akun tidak tersedia" %> · dibuat <%= mapping.created_by&.full_name || "sistem" %> · revisi <%= mapping.source_revision || "tidak dicatat" %></p></div>
        </div>
        <details class="mt-3">
          <summary class="cursor-pointer text-sm font-medium text-indigo-700">Rekonsiliasi identifier</summary>
          <%= form_with scope: :external_identity_mapping, url: external_identity_mapping_path(mapping), method: :patch,
            class: "mt-3 grid gap-2 sm:grid-cols-2" do |f| %>
            <%= f.collection_select :student_id, @students, :id, :full_name, { selected: mapping.internal_record_id }, class: "rounded-lg border-gray-300" %>
            <%= f.text_field :reason, required: true, minlength: 10, placeholder: "Alasan koreksi pemetaan", class: "rounded-lg border-gray-300" %>
            <%= f.submit "Rekonsiliasi dengan audit", class: "w-fit rounded-lg border border-amber-300 px-3 py-2 text-sm font-semibold text-amber-900" %>
          <% end %>
        </details>
        <% if mapping.events.any? %>
          <ul class="mt-3 border-t pt-2 text-xs text-gray-500">
            <% mapping.events.order(changed_at: :desc).each do |event| %>
              <li><%= l(event.changed_at, format: :long) %> · <%= event.changed_by.full_name %> · mahasiswa #<%= event.previous_internal_record_id %> → #<%= event.new_internal_record_id %>: <%= event.reason %></li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
    <% if @mappings.empty? %><p class="rounded-xl bg-white p-5 text-sm text-gray-500">Belum ada identifier yang dipetakan.</p><% end %>
  </section>
</div>
